(in-package #:cl-gpu/expressions)

(defun expression-code (body leaves)
  (if (atom body) body
      (let ((op (car body)))
        (if (eq op :input) (nth (second body) leaves)
            (let ((args (mapcar (lambda (child) (expression-code child leaves)) (cdr body))))
              (case op
                (:select `(if ,@args))
                (:sigmoid (ew::sigmoid-code (first args)))
                ((:add :subtract :multiply :divide :min :max)
                 (let ((operator (ecase op (:add '+) (:subtract '-) (:multiply '*) (:divide '/)
                                          (:min 'min) (:max 'max))))
                   (if (and (null (cdr args)) (member op '(:subtract :divide)))
                       (if (eq op :divide) `(/ 1f0 ,(first args)) `(- ,(first args)))
                       (reduce (lambda (a b) `(,operator ,a ,b)) (cdr args) :initial-value (car args)))))
                (otherwise
                 `(,(ecase op (:abs 'abs) (:sqrt 'sqrt) (:exp 'exp) (:sin 'sin) (:cos 'cos)
                              (:log 'log) (:tanh 'tanh) (:fma 'gpu:fma)
                              (:eq '=) (:ne '/=) (:lt '<) (:le '<=) (:gt '>) (:ge '>=)) ,@args))))))))

(defun region-kernel (body types result-element maskp predicatep raw)
  ;; TODO: O(rank) indexing per element; coalesce axes and specialize contiguous layouts (#76).
  (let ((parameters `((out (gpu:ptr ,result-element :global))
                      (metadata (gpu:ptr gpu:i64 :global)) (rank gpu:u32)
                      (count gpu:i64) (start gpu:i64) (obase gpu:i64)))
        (offsets '((oi obase))) (leaves nil) (mask nil))
    (loop for type in (append types (when maskp (list 'gpu:u8))) for i from 0
          for x = (intern (format nil "X~d" i) '#:cl-gpu/expressions)
          for base = (intern (format nil "BASE~d" i) '#:cl-gpu/expressions)
          for at = (intern (format nil "AT~d" i) '#:cl-gpu/expressions)
          for masked = (and maskp (= i (length types)))
          do (if (eq type :scalar)
                 (progn (setf parameters (append parameters `((,x gpu:f32)))) (push x leaves))
                 (progn
                   (setf parameters (append parameters `((,x (gpu:ptr ,type :global)) (,base gpu:i64))))
                   (push (list at base) offsets)
                   (if masked (setf mask `(aref ,x ,at))
                       (push (if raw `(aref ,x ,at) `(gpu:convert gpu:f32 (aref ,x ,at))) leaves)))))
    (let* ((width (1+ (length offsets)))
           (code (expression-code body (nreverse leaves)))
           (value (if predicatep `(if ,code 1 0) code)))
      (gpu::make-gpu-kernel
       'expression parameters
       `(let ((position (+ start (gpu:convert gpu:i64 (gpu:global-id 0)))))
          (when (< position count)
            (let ,(reverse offsets)
              (let ((q position))
                (gpu:for (axis (gpu:convert gpu:u32 0) (< axis rank) (incf axis))
                  (let* ((row (* (gpu:convert gpu:i64 axis) ,width))
                         (dimension (aref metadata row)) (coordinate (rem q dimension)))
                    ,@(loop for offset in (reverse offsets) for column from 1
                            collect `(incf ,(first offset) (* coordinate (aref metadata (+ row ,column)))))
                    (setf q (/ q dimension)))))
              ,(if mask
                   `(when (/= ,mask 0) (setf (aref out oi) (gpu:convert ,result-element ,value)))
                   `(setf (aref out oi) (gpu:convert ,result-element ,value))))))
       :precise-math t))))

(defun reduction-coordinate-code (position first end)
  `(let ((q ,position))
     (gpu:for (axis ,first (< axis ,end) (incf axis))
       (let* ((row (* (gpu:convert gpu:i64 axis) 2))
              (dimension (aref metadata row)) (coordinate (rem q dimension)))
         (incf at (* coordinate (aref metadata (+ row 1))))
         (setf q (/ q dimension))))))

(defun reduction-tree-code (combine)
  `(progn
     (gpu:barrier)
     (gpu:for (step (gpu:shr (gpu:group-size 0) 1) (> step 0) (setf step (gpu:shr step 1)))
       (when (< lid step) (let ((other (+ lid step))) ,@combine))
       (gpu:barrier))))

(defun reduction-kernel (operation maskp)
  (let* ((any (eq operation :any))
         (extreme (member operation '(:minimum :maximum :argmin :argmax)))
         (indexp (member operation '(:argmin :argmax)))
         (lessp (member operation '(:minimum :argmin)))
         (combine (case operation (:prod '*) (:any 'max) (otherwise '+)))
         (output (cond (any 'gpu:u8) (indexp 'gpu:i64) (t 'gpu:f32))))
    (gpu::make-gpu-kernel
     'expression-reduction
     `((x (gpu:ptr ,(if any 'gpu:u8 'gpu:f32) :global))
       (out (gpu:ptr ,output :global)) (metadata (gpu:ptr gpu:i64 :global))
       (kept gpu:u32) (rank gpu:u32) (width gpu:i64) (xbase gpu:i64) (first-group gpu:i64)
       ,@(when maskp '((demand (gpu:ptr gpu:u8 :global)))))
     `(let ((group (+ first-group (gpu:convert gpu:i64 (gpu:group-id 0)))))
        ,@(let ((body
                  `(let ((tile (gpu:shared-array gpu:f32 256))
                         ,@(when extreme '((indices (gpu:shared-array gpu:i64 256))))
                         (lid (gpu:local-id 0)) (at xbase)
                         (value ,(if (eq operation :prod) 1f0 0f0))
                         ,@(when extreme '((found width))))
                     (declare (type gpu:i64 at ,@(when extreme '(found))) (type gpu:f32 value))
                     ,(reduction-coordinate-code 'group '(gpu:convert gpu:u32 0) 'kept)
                     (let ((base at))
                       (gpu:for (i (gpu:convert gpu:i64 lid) (< i width) (incf i (gpu:convert gpu:i64 256)))
                         (setf at base)
                         ,(reduction-coordinate-code 'i 'kept 'rank)
                         (let ((candidate (gpu:convert gpu:f32 (aref x at))))
                           ,(if extreme
                                `(when (or (= found width) (,(if lessp '< '>) candidate value))
                                   (setf value candidate found i))
                                `(setf value (,combine value candidate))))))
                     (setf (aref tile lid) value)
                     ,@(when extreme '((setf (aref indices lid) found)))
                     ,(reduction-tree-code
                       (if extreme
                           `((let ((candidate (aref tile other)) (index (aref indices other)))
                               (when (and (< index width)
                                          (or (= (aref indices lid) width)
                                              (,(if lessp '< '>) candidate (aref tile lid))
                                              (and (= candidate (aref tile lid)) (< index (aref indices lid)))))
                                 (setf (aref tile lid) candidate (aref indices lid) index))))
                           `((setf (aref tile lid) (,combine (aref tile lid) (aref tile other))))))
                     (when (= lid 0)
                       (setf (aref out group)
                             ,(cond (indexp '(aref indices 0))
                                    (any '(gpu:convert gpu:u8 (if (> (aref tile 0) 0f0) 1 0)))
                                    (t '(aref tile 0))))))))
            (list (if maskp `(when (/= (aref demand group) 0) ,body) body))))
     :precise-math t)))
