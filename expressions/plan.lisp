(in-package #:cl-gpu/expressions)

(defstruct (expression-plan (:constructor %make-plan (parameters body references)))
  parameters body references
  (kernels (make-hash-table :test #'equal))
  (lock (bt:make-lock "expression variants")))

(defun reducer-p (operator)
  (member operator '(:sum :prod :minimum :maximum :argmin :argmax)))

(defun comparison-p (operator)
  (member operator '(:eq :ne :lt :le :gt :ge)))

(defun f32-value (value)
  (unless (realp value) (gpu::gpu-fail "expression scalars must be real"))
  (handler-case (coerce value 'single-float)
    (arithmetic-error () (gpu::gpu-fail "expression scalar does not fit f32"))))

(defun proper-list-p (value)
  (and (listp value) (handler-case (integerp (list-length value)) (type-error () nil))))

(defun make-expression-plan (parameters expression)
  "Validate EXPRESSION over positional PARAMETERS; retain no device operands."
  (unless (and (proper-list-p parameters)
               (every (lambda (p) (and (symbolp p) p (not (eq p t))
                                      (not (keywordp p)) (not (member p lambda-list-keywords)))) parameters)
               (= (length parameters) (length (remove-duplicates parameters))))
    (gpu::gpu-fail "expression parameters must be distinct variable names"))
  (let ((references nil) (*print-circle* t))
    (labels ((walk (node &optional ancestors)
               (when (member node ancestors :test #'eq) (gpu::gpu-fail "cyclic expression"))
               (cond
                 ((realp node) (values (f32-value node) :numeric))
                 ((and (symbolp node) (member node parameters))
                  (let ((index (position node parameters)))
                    (pushnew index references)
                    (values (list :input index) :numeric)))
                 ((and (consp node) (proper-list-p node))
                  (let* ((op (car node)) (count (length (cdr node)))
                         (arity (cond ((or (reducer-p op) (member op '(:abs :sqrt :exp :sin :cos :log :tanh :sigmoid))) 1)
                                      ((comparison-p op) 2)
                                      ((member op '(:select :fma)) 3)
                                      ((member op '(:add :subtract :multiply :divide :min :max)) :many))))
                    (unless (and arity (if (eq arity :many) (plusp count) (= count arity)))
                      (gpu::gpu-fail "unsupported expression or arity: ~s" node))
                    (values
                     (cons op (loop for child in (cdr node) for i from 0
                                    collect (multiple-value-bind (body kind) (walk child (cons node ancestors))
                                              (unless (eq kind (if (and (eq op :select) (zerop i)) :mask :numeric))
                                                (gpu::gpu-fail "invalid expression operand: ~s" node))
                                              body)))
                     (if (comparison-p op) :mask :numeric))))
                 (t (gpu::gpu-fail "invalid expression leaf: ~s" node)))))
      (multiple-value-bind (body kind) (walk expression)
        (unless (eq kind :numeric) (gpu::gpu-fail "expression result must be numeric"))
        (%make-plan (copy-list parameters) body (sort references #'<))))))

(defstruct context plan operands shape element device axes width groups result-shape result-element
  owned tasks (memo (make-hash-table :test #'equal)))

(defun expression-context (plan operands axis keepdims)
  (unless (expression-plan-p plan) (gpu::gpu-fail "expected an expression plan"))
  (unless (and (or (vectorp operands) (proper-list-p operands))
               (= (length operands) (length (expression-plan-parameters plan))))
    (gpu::gpu-fail "operand count does not match expression parameters"))
  (let* ((values (map 'vector #'identity operands))
         (inputs (loop for index in (expression-plan-references plan) collect (aref values index)))
         (views (remove-if-not #'gpu:strided-view-p inputs))
         (first (car views))
         (body (expression-plan-body plan))
         (outer (and (consp body) (reducer-p (car body)) (car body))))
    (unless first (gpu::gpu-fail "a referenced numeric strided view is required"))
    (let* ((element (gpu::float-view-element first))
           (device (gpu:gpu-array-device (gpu:strided-view-data first)))
           (shape (ew::broadcast-shape inputs))
           (axes (red::normalize-axes axis (length shape)))
           (width (reduce #'* axes :key (lambda (a) (aref shape a)) :initial-value 1))
           (groups (reduce #'* (loop for a below (length shape) unless (member a axes) collect (aref shape a))
                           :initial-value 1))
           (result-shape (if outer (red::result-shape shape axes keepdims) shape))
           (result-element (if (member outer '(:argmin :argmax))
                               'gpu:i64 element)))
      (unless (eq (gpu:device-target device) :metal)
        (gpu::gpu-fail "expression execution requires a Metal-capable backend"))
      (when (and keepdims (not outer)) (gpu::gpu-fail "keepdims requires a top-level reduction"))
      (dolist (input views)
        (gpu::check-view input)
        (unless (and (eq element (gpu::float-view-element input))
                     (eq device (gpu:gpu-array-device (gpu:strided-view-data input))))
          (gpu::gpu-fail "expression inputs require one dtype and device")))
      (dolist (index (expression-plan-references plan))
        (unless (gpu:strided-view-p (aref values index))
          (setf (aref values index) (f32-value (aref values index)))))
      (unless (and (typep width '(integer 0 #.(- (expt 2 63) 257)))
                   (every (lambda (n) (typep n '(integer 0 #.(1- (expt 2 63)))))
                          (list groups (gpu::shape-size shape))))
        (gpu::gpu-fail "expression shape exceeds signed 64-bit indexing"))
      (unless (every (lambda (n) (typep n '(signed-byte 64))) (gpu::row-strides shape))
        (gpu::gpu-fail "expression strides exceed signed 64-bit indexing"))
      (when (and outer (plusp groups) (zerop width)
                 (member outer '(:minimum :maximum :argmin :argmax)))
        (gpu::gpu-fail "empty expression groups have no extreme"))
      (make-context :plan plan :operands values :shape shape :element element :device device
                    :axes axes :width width :groups groups :result-shape result-shape
                    :result-element result-element))))

(defun expression-result-info (plan operands &key axis keepdims)
  "Return shape, element-type symbol and device without device allocation or transfers."
  (let ((context (expression-context plan operands axis keepdims)))
    (values (copy-seq (context-result-shape context)) (context-result-element context)
            (context-device context))))

(defun cached-kernel (context key builder)
  (let ((plan (context-plan context)))
    (bt:with-lock-held ((expression-plan-lock plan))
      (or (gethash key (expression-plan-kernels plan))
          (setf (gethash key (expression-plan-kernels plan)) (funcall builder))))))
