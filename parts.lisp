(in-package #:cl-gpu)

(defstruct kernel-parameter variable name mode)
(defstruct (kernel-parts (:constructor make-kernel-parts))
  header body parameters inputs outputs attributes precise-math)

(defclass embedded-msl-printer (msl-printer) ())

(defmethod position-name ((printer embedded-msl-printer) attribute)
  (pushnew attribute (printer-positions printer) :test #'string=)
  attribute)

(defun pointer-roots (expr aliases)
  (let ((roots '()))
    (when expr
      (map-ir (lambda (node)
                (when (ir-var-p node)
                  (setf roots (union roots (gethash (ir-var-variable node) aliases)))))
              expr))
    roots))

(defun parameter-accesses (kernel)
  (let ((aliases (make-hash-table :test 'eq))
        (reads (make-hash-table :test 'eq))
        (writes (make-hash-table :test 'eq)))
    (dolist (parameter (ir-kernel-parameters kernel))
      (when (pointer-type-p (ir-variable-type parameter))
        (setf (gethash parameter aliases) (list parameter))))
    (loop with changed = t while changed do
      (setf changed nil)
      (map-ir
       (lambda (node)
         (multiple-value-bind (variable value)
             (typecase node
               (ir-declare (values (ir-declare-variable node) (ir-declare-init node)))
               (ir-assign (when (ir-var-p (ir-assign-target node))
                            (values (ir-var-variable (ir-assign-target node)) (ir-assign-value node)))))
           (when (and variable (pointer-type-p (ir-variable-type variable)))
             (let* ((old (gethash variable aliases))
                    (new (union old (pointer-roots value aliases))))
               (unless (= (length old) (length new))
                 (setf (gethash variable aliases) new changed t))))))
       kernel))
    (labels ((mark (expr table)
               (dolist (root (pointer-roots expr aliases)) (setf (gethash root table) t)))
             (visit (node &optional store)
               (typecase node
                 (ir-assign (visit (ir-assign-target node) t) (visit (ir-assign-value node)))
                 (ir-index
                  (mark (ir-index-base node) (if store writes reads))
                  (visit (ir-index-base node)) (visit (ir-index-index node)))
                 (ir-component (visit (ir-component-base node) store))
                 (ir-intrinsic
                  (let ((name (intrinsic-name (ir-intrinsic-intrinsic node))))
                    (when (search "ATOMIC-" (symbol-name name))
                      (unless (eq name 'atomic-store) (mark (first (ir-intrinsic-args node)) reads))
                      (unless (eq name 'atomic-load) (mark (first (ir-intrinsic-args node)) writes)))
                  (dolist (child (ir-children node)) (visit child))))
                 (t (dolist (child (ir-children node)) (visit child))))))
      (visit kernel))
    (values reads writes)))

(defun kernel-parts (kernel target &key initialized-outputs printer)
  "Return embeddable source and ordered binding descriptors for KERNEL."
  (unless (eq target :metal) (target-fail "Embedded output supports Metal only"))
  (let* ((ir (if (gpu-kernel-p kernel) (kernel-ir kernel) kernel))
         (printer (or printer (make-instance 'embedded-msl-printer)))
         (parameters '()))
    (check-target-support printer ir)
    (begin-kernel printer ir)
    (multiple-value-bind (reads writes) (parameter-accesses ir)
      (dolist (variable (ir-kernel-parameters ir))
        (let* ((type (ir-variable-type variable))
               (pointer (pointer-type-p type))
               (read (gethash variable reads)) (write (gethash variable writes)))
          (when (and pointer (member (pointer-type-space type) '(:shared :private)))
            (target-fail "Host cannot bind ~a pointer parameter ~a"
                         (pointer-type-space type) (ir-variable-name variable)))
          (when (and pointer write (eq (pointer-type-space type) :constant))
            (target-fail "Cannot write constant parameter ~a" (ir-variable-name variable)))
          (when (and read write (not initialized-outputs))
            (target-fail "Read/write output ~a requires explicit initialization" (ir-variable-name variable)))
          (push (make-kernel-parameter :variable variable
                                      :name (if (member variable (printer-copies printer))
                                                (format nil "cl_gpu_~a" (variable-name printer variable))
                                                (variable-name printer variable))
                                      :mode (cond ((not pointer) :value)
                                                  ((and read write) :inout) (write :output) (t :input)))
                parameters))))
    (setf parameters (nreverse parameters))
    (let ((body (with-output-to-string (out)
                  (setf (printer-stream printer) out)
                  (print-prologue printer ir)
                  (dolist (statement (ir-kernel-body ir)) (print-statement printer statement))))
          (header (with-output-to-string (out) (print-prelude printer out))))
      (make-kernel-parts
       :header header :body body :parameters parameters
       :inputs (remove-if (lambda (p) (member (kernel-parameter-mode p) '(:output :inout))) parameters)
       :outputs (remove-if-not (lambda (p) (member (kernel-parameter-mode p) '(:output :inout))) parameters)
       :attributes (sort (copy-list (printer-positions printer)) #'string<)
       :precise-math (and (gpu-kernel-p kernel) (gpu-kernel-precise-math kernel))))))
