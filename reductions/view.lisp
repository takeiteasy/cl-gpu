(in-package #:cl-gpu/reductions)

(defun normalize-axes (axis rank)
  (let ((axes (cond ((null axis) (loop for a below rank collect a))
                    ((integerp axis) (list axis))
                    ((typep axis 'sequence) (coerce axis 'list))
                    (t (gpu-fail "axis must be NIL, an integer or a sequence"))))
        (result nil))
    (dolist (a axes)
      (unless (and (integerp a) (<= (- rank) a) (< a rank))
        (gpu-fail "invalid axis ~s for rank ~d" a rank))
      (let ((a (mod a rank)))
        (when (member a result) (gpu-fail "duplicate axis ~d" a))
        (push a result)))
    (sort result #'<)))
