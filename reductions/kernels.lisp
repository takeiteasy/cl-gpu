(in-package #:cl-gpu/reductions)

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun kernel-name (operation element)
    (intern (format nil "%~a-~a" operation element) '#:cl-gpu/reductions))

  (defun coordinate-code (position first end &rest offsets)
    (let ((q (gensym "POSITION")) (a (gensym "AXIS")) (at (gensym "META"))
          (dimension (gensym "DIMENSION")) (coordinate (gensym "COORDINATE")))
      `(let ((,q ,position))
         (declare (type i64 ,q))
         (for (,a ,first (< ,a ,end) (incf ,a))
           (let* ((,at (* (convert i64 ,a) 4))
                  (,dimension (aref metadata ,at))
                  (,coordinate (rem ,q ,dimension)))
             ,@(loop for (variable column) on offsets by #'cddr
                     collect `(incf ,variable (* ,coordinate (aref metadata (+ ,at ,column)))))
             (setf ,q (/ ,q ,dimension)))))))

  (defun tree-code (combine)
    `(progn
       (barrier)
       (for (step (shr (group-size 0) 1) (> step 0) (setf step (shr step 1)))
         (when (< lid step)
           (let ((other (+ lid step))) ,@combine))
         (barrier)))))

(defmacro define-reducer (operation element)
  (let* ((extreme (member operation '(minimum maximum argmin argmax)))
         (indexp (member operation '(argmin argmax)))
         (lessp (member operation '(minimum argmin)))
         (read-value `(convert f32 (aref x at)))
         (update (if (eq operation 'prod) '* '+)))
    (sublis (when (eq element 'f64) '((f32 . f64)))
     `(define-kernel ,(kernel-name operation element)
         ((x (ptr ,element :global)) (y (ptr ,(if indexp 'i64 element) :global))
          (metadata (ptr i64 :global)) (kept u32) (rank u32) (width i64)
          (xbase i64) (ybase i64) (first-group i64))
       (declare (precise-math))
       (let ((tile (shared-array f32 256))
             ,@(when extreme '((indices (shared-array i64 256))))
             (lid (local-id 0))
             (input-base xbase) (output-base ybase)
             (value ,(if (eq operation 'prod) 1.0 0.0))
             ,@(when extreme '((found width))))
         (declare (type i64 input-base output-base ,@(when extreme '(found))) (type f32 value))
         ,(coordinate-code '(+ first-group (convert i64 (group-id 0))) 0 'kept
                           'input-base 1 'output-base 2)
         (for (i (convert i64 lid) (< i width) (incf i (convert i64 (group-size 0))))
           (let ((at input-base))
             (declare (type i64 at))
             ,(coordinate-code 'i 'kept 'rank 'at 1)
             ,(if extreme
                  `(let ((candidate ,read-value))
                     (when (or (= found width) (,(if lessp '< '>) candidate value))
                       (setf value candidate found i)))
                  `(setf value (,update value ,read-value)))))
         (setf (aref tile lid) value)
         ,@(when extreme '((setf (aref indices lid) found)))
         ,(tree-code
           (if extreme
               `((let ((candidate (aref tile other)) (index (aref indices other)))
                   (when (and (< index width)
                              (or (= (aref indices lid) width)
                                  (,(if lessp '< '>) candidate (aref tile lid))
                                  (and (= candidate (aref tile lid)) (< index (aref indices lid)))))
                     (setf (aref tile lid) candidate (aref indices lid) index))))
               `((setf (aref tile lid) (,update (aref tile lid) (aref tile other))))))
         (when (= lid 0)
           (setf (aref y output-base)
                 ,(if indexp '(aref indices 0)
                      `(convert ,element ,(if (eq operation 'mean)
                                             '(/ (aref tile 0) (convert f32 width))
                                             '(aref tile 0)))))))))))

(defmacro define-normalizer (operation element)
  (let ((softp (eq operation 'softmax)))
    (sublis (when (eq element 'f64) '((f32 . f64)))
     `(define-kernel ,(kernel-name operation element)
         ((x (ptr ,element :global)) (y (ptr ,element :global)) (weights (ptr ,element :global))
          (metadata (ptr i64 :global)) (kept u32) (rank u32) (width i64)
          (xbase i64) (ybase i64) (wbase i64) (first-group i64)
          (weighted u32) (weight f32) (epsilon f32))
       (declare (precise-math))
       (let ((tile (shared-array f32 256)) (lid (local-id 0))
             (input-base xbase) (output-base ybase) (weight-base wbase)
             (value 0.0))
         (declare (type i64 input-base output-base weight-base) (type f32 value))
         ,(coordinate-code '(+ first-group (convert i64 (group-id 0))) 0 'kept
                           'input-base 1 'output-base 2 'weight-base 3)
         ,@(when softp
             `((setf value (convert f32 (aref x input-base)))
               (for (i (convert i64 lid) (< i width) (incf i (convert i64 (group-size 0))))
                 (let ((at input-base))
                   (declare (type i64 at))
                   ,(coordinate-code 'i 'kept 'rank 'at 1)
                   (setf value (max value (convert f32 (aref x at))))))
               (setf (aref tile lid) value)
               ,(tree-code '((setf (aref tile lid) (max (aref tile lid) (aref tile other)))))
               (setf value (aref tile 0))
               (barrier)))
         (let ((total 0.0))
           (declare (type f32 total))
           (for (i (convert i64 lid) (< i width) (incf i (convert i64 (group-size 0))))
             (let ((at input-base))
               (declare (type i64 at))
               ,(coordinate-code 'i 'kept 'rank 'at 1)
               (let ((v (convert f32 (aref x at))))
                 (incf total ,(if softp '(exp (- v value)) '(* v v))))))
           (setf (aref tile lid) total)
           ,(tree-code '((incf (aref tile lid) (aref tile other))))
           (let ((scale ,(if softp '(/ 1.0 (aref tile 0))
                            '(/ 1.0 (sqrt (+ (/ (aref tile 0) (convert f32 width)) epsilon))))))
             (for (i (convert i64 lid) (< i width) (incf i (convert i64 (group-size 0))))
               (let ((at input-base) (to output-base) (wt weight-base))
                 (declare (type i64 at to wt))
                 ,(coordinate-code 'i 'kept 'rank 'at 1 'to 2 'wt 3)
                 (let ((v (convert f32 (aref x at))))
                   (setf (aref y to)
                         (convert ,element
                                  (* ,(if softp '(exp (- v value)) 'v) scale
                                     ,(if softp 1.0
                                          '(if (= weighted 1)
                                               (convert f32 (aref weights wt)) weight)))))))))))))))

(defmacro define-scatter (element)
  `(define-kernel ,(kernel-name 'scatter element)
       ((x (ptr ,element :global)) (y (ptr ,element :global))
        (metadata (ptr i64 :global)) (rank u32) (n i64) (base i64) (start i64))
     (let ((i start) (lane (convert i64 (global-id 0))))
       (when (< lane (- n start))
         (incf i lane)
         (let ((to base))
           (declare (type i64 to))
           ,(coordinate-code 'i 0 'rank 'to 2)
           (setf (aref y to) (aref x i)))))))

(defmacro define-all-kernels ()
  `(progn
     ,@(loop for element in '(f32 f16 bf16 f64)
             append (append (loop for operation in '(sum mean prod minimum maximum argmin argmax)
                                  collect `(define-reducer ,operation ,element))
                            (loop for operation in '(softmax rmsnorm)
                                  collect `(define-normalizer ,operation ,element))
                            `((define-scatter ,element))))))

(define-all-kernels)
