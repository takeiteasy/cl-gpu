(in-package #:cl-gpu/elementwise)

(defun broadcast-shape (inputs)
  (let* ((views (remove-if-not #'gpu:strided-view-p inputs))
         (rank (reduce #'cl:max views :key (lambda (v) (length (gpu:strided-view-shape v))) :initial-value 0))
         (shape (make-array rank :initial-element 1)))
    (dolist (view views shape)
      (loop for dimension across (gpu:strided-view-shape view)
            for axis from (- rank (length (gpu:strided-view-shape view)))
            for current = (aref shape axis)
            do (cond ((= current dimension))
                     ((= current 1) (setf (aref shape axis) dimension))
                     ((/= dimension 1) (gpu-fail "incompatible broadcast shapes")))))))

(defun broadcast-strides (view shape)
  (let* ((source (gpu:strided-view-shape view))
         (strides (make-array (length shape) :initial-element 0)))
    (loop for dimension across source for stride across (gpu:strided-view-strides view)
          for axis from (- (length shape) (length source))
          unless (= dimension 1) do (setf (aref strides axis) stride))
    strides))

(defun checked-element (view)
  (check-view view)
  (let ((type (gpu:gpu-array-element-type (gpu:strided-view-data view))))
    (unless (or (and (typep type 'gpu:scalar-type)
                     (member (gpu:scalar-type-name type) *elements*))
                (typep type 'gpu:complex-type))
      (gpu-fail "elementwise operations require supported real or complex elements"))
    (gpu:type-spec type)))

(defun scalar-value (value element)
  (when (complex-element-p element)
    (unless (numberp value) (gpu-fail "complex scalar must be numeric"))
    (return-from scalar-value
      (vector (scalar-value (cl:realpart value) (component-element element))
              (scalar-value (cl:imagpart value) (component-element element)))))
  (unless (gpu::scalar-value-p (gpu:parse-type element) value)
    (gpu-fail "scalar ~s does not fit ~s" value element))
  (if (float-element-p element)
      (handler-case (coerce value (if (eq element 'gpu:f64) 'double-float 'single-float))
        (arithmetic-error () (gpu-fail "scalar does not fit ~s" element))) value))

(defun allocate-result (shape element device)
  (let ((data (gpu:make-gpu-array (shape-size shape) :element-type element :device device)))
    (handler-case (gpu:make-strided-view data shape)
      (error (e) (gpu:free data) (error e)))))

(defun prepare-operation (operation out inputs operator)
  (dolist (input inputs) (when (gpu:strided-view-p input) (checked-element input)))
  (let* ((numeric (if (eq operation :select) (rest inputs) inputs))
         (context (find-if #'gpu:strided-view-p numeric)))
    (unless context (gpu-fail "at least one numeric strided view is required"))
    (let* ((element (checked-element context))
           (device (gpu:gpu-array-device (gpu:strided-view-data context)))
           (shape (broadcast-shape inputs))
           (result-element (case operation (:compare 'gpu:u8) (:convert operator)
                                 ((:abs :realpart :imagpart) (component-element element))
                                 (otherwise element))))
      (unless (and (typep (shape-size shape) '(integer 0 #.(1- (expt 2 63))))
                   (every (lambda (stride) (typep stride '(signed-byte 64))) (gpu::row-strides shape)))
        (gpu-fail "broadcast shape exceeds signed 64-bit indexing"))
      (unless (or (member result-element *elements*) (complex-element-p result-element)) (gpu-fail "unsupported destination element type"))
      (when (complex-element-p element)
        (unless (and (member operation '(:add :subtract :multiply :divide :negate :abs :compare
                                        :select :convert :copy :conjugate :realpart :imagpart))
                     (or (not (eq operation :compare)) (member operator '(:eq :ne))))
          (gpu-fail "unsupported complex operation ~s ~s" operation operator)))
      (when (and (member operation '(:conjugate :realpart :imagpart))
                 (not (complex-element-p element)))
        (gpu-fail "~s requires complex inputs" operation))
      (when (and (member operation '(:sqrt :reciprocal :exp :log :sin :cos :tanh :sigmoid :silu :gelu))
                 (not (float-element-p element)))
        (gpu-fail "~s requires floating-point inputs" operation))
      (when (and (eq operation :convert)
                 (or (member element '(gpu:f16 gpu:bf16)) (member result-element '(gpu:f16 gpu:bf16)))
                 (not (and (or (float-element-p element) (complex-element-p element))
                           (or (float-element-p result-element) (complex-element-p result-element)))))
        (gpu-fail "f16/bf16 conversion requires floating components"))
      (when (and (eq operation :compare) (not (member operator '(:eq :ne :lt :le :gt :ge))))
        (gpu-fail "unknown comparison operator ~s" operator))
      (when (eq operation :select)
        (unless (and (gpu:strided-view-p (first inputs)) (eq (checked-element (first inputs)) 'gpu:u8))
          (gpu-fail "select requires a u8 mask view")))
      (loop for input in inputs for i from 0
            for expected = (if (and (eq operation :select) (zerop i)) 'gpu:u8 element)
            do (if (gpu:strided-view-p input)
                   (unless (and (eq expected (checked-element input))
                                (eq device (gpu:gpu-array-device (gpu:strided-view-data input))))
                     (gpu-fail "operands require matching types and one device"))
                   (scalar-value input expected)))
      (when (and (eq operation :clamp) (realp (second inputs)) (realp (third inputs))
                 (> (second inputs) (third inputs)))
        (gpu-fail "clamp lower bound exceeds upper bound"))
      (gpu::require-native-f64 device operation element result-element)
      (when out
        (unless (and (eq result-element (checked-element out))
                     (equalp shape (gpu:strided-view-shape out))
                     (eq device (gpu:gpu-array-device (gpu:strided-view-data out)))
                     (unique-view-p out))
          (gpu-fail "destination requires matching shape, type, device and unique addresses")))
      (values shape element result-element device))))

(defun operation-metadata (shape out inputs)
  (let* ((views (remove-if-not #'gpu:strided-view-p inputs))
         (width (+ 2 (length views)))
         (rank (length shape))
         (data (make-array (* width rank) :element-type '(signed-byte 64)))
         (layouts (cons (gpu:strided-view-strides out)
                        (mapcar (lambda (v) (broadcast-strides v shape)) views))))
    (dotimes (row rank data)
      (let ((axis (- rank row 1)))
        (setf (aref data (* row width)) (aref shape axis))
        (loop for layout in layouts for column from 1
              do (setf (aref data (+ (* row width) column)) (aref layout axis)))))))

(defun execute-operation (operation out inputs &key operator (rounding :nearest-even))
  (unless (member rounding '(:nearest-even :truncate :floor :ceiling))
    (gpu-fail "unknown conversion rounding mode ~s" rounding))
  (multiple-value-bind (shape element result-element device)
      (prepare-operation operation out inputs operator)
    (let* ((result (or out (allocate-result shape result-element device)))
           (alias (and out (some (lambda (v) (and (gpu:strided-view-p v) (views-overlap-p v out))) inputs)))
           (scratch nil) (metadata nil) (status nil) (success nil)
           (checked (or (and (eq operation :clamp) (some #'gpu:strided-view-p (rest inputs)))
                        (and (eq operation :divide) (not (or (float-element-p element) (complex-element-p element))))
                        (and (eq operation :convert)
                             (or (and (complex-element-p element) (not (complex-element-p result-element)))
                                 (and (float-element-p element)
                                      (not (or (float-element-p result-element)
                                               (complex-element-p result-element)))))))))
      (unwind-protect
           (progn
             (unless (zerop (shape-size shape))
               (when alias (setf scratch (allocate-result shape result-element device)))
               (let* ((target (or scratch result))
                      (kinds (mapcar (lambda (v) (if (gpu:strided-view-p v) :view :scalar)) inputs))
                      (kernel (operation-kernel operation element result-element kinds operator checked))
                      (args (loop for input in inputs for i from 0
                                  for type = (if (and (eq operation :select) (zerop i)) 'gpu:u8 element)
                                  append (if (gpu:strided-view-p input)
                                             (list (operation-root input operation) (view-base input))
                                             (list (scalar-value input type))))))
                 (setf metadata (gpu:to-device (operation-metadata shape target inputs)
                                               :element-type 'gpu:i64 :device device))
                 (when checked (setf status (gpu:make-gpu-array 1 :element-type 'gpu:u32 :device device)))
                 (loop for start from 0 below (shape-size shape) by 16776960
                       for count = (cl:min 16776960 (- (shape-size shape) start))
                       do (gpu::launch kernel
                                       (append (list (operation-root target operation) metadata (length shape)
                                                     (shape-size shape) start (view-base target)) args
                                               (when checked (list status))
                                               (when (eq operation :convert)
                                                 (list (position rounding '(:nearest-even :truncate :floor :ceiling)))))
                                       :grid (* 256 (ceiling count 256)) :group 256 :device device))
                 (when (and checked (not (zerop (aref (gpu:from-device status) 0))))
                   (gpu-fail "~a: invalid ~a" operation
                             (case operation (:divide "integer divisor") (:clamp "clamp bounds")
                                   (otherwise "complex-to-real or NaN-to-integer conversion"))))
                 (when alias (execute-operation (if (eq operation :convert) :convert :copy) out (list scratch)
                                                     :operator result-element))))
             (setf success t)
             result)
        (when metadata (gpu:free metadata))
        (when status (gpu:free status))
        (when scratch (gpu:free (gpu:strided-view-data scratch)))
        (unless (or success out) (gpu:free (gpu:strided-view-data result)))))))

(defmacro define-operation (name operation arguments)
  (let ((destination (intern (format nil "~a!" name))))
    `(progn
       (defun ,name ,arguments
         ,(format nil "Apply ~a with broadcasting; return independent storage." operation)
         (execute-operation ,operation nil (list ,@arguments)))
       (defun ,destination (out ,@arguments)
         ,(format nil "Apply ~a with broadcasting into OUT; return OUT." operation)
         (check-view out)
         (execute-operation ,operation out (list ,@arguments))))))

(define-operation add :add (a b))
(define-operation subtract :subtract (a b))
(define-operation multiply :multiply (a b))
(define-operation divide :divide (a b))
(define-operation min :min (a b))
(define-operation max :max (a b))
(define-operation negate :negate (input))
(define-operation abs :abs (input))
(define-operation sqrt :sqrt (input))
(define-operation reciprocal :reciprocal (input))
(define-operation exp :exp (input))
(define-operation log :log (input))
(define-operation sin :sin (input))
(define-operation cos :cos (input))
(define-operation tanh :tanh (input))
(define-operation sigmoid :sigmoid (input))
(define-operation silu :silu (input))
(define-operation gelu :gelu (input))
(define-operation clamp :clamp (input lower upper))
(define-operation select :select (mask on-true on-false))
(define-operation conjugate :conjugate (input))
(define-operation realpart :realpart (input))
(define-operation imagpart :imagpart (input))

(defun compare (operator a b)
  "Compare broadcast operands with OPERATOR; return an independent u8 mask."
  (execute-operation :compare nil (list a b) :operator operator))
(defun compare! (out operator a b)
  "Compare broadcast operands into the u8 mask OUT; return OUT."
  (check-view out)
  (execute-operation :compare out (list a b) :operator operator))
(defun convert (input element-type &key (rounding :nearest-even))
  "Convert INPUT into independent ELEMENT-TYPE storage with ROUNDING."
  (unless (gpu:strided-view-p input) (gpu-fail "conversion requires an input view"))
  (let ((type (gpu:parse-type element-type)))
    (unless (typep type '(or gpu:scalar-type gpu:complex-type)) (gpu-fail "conversion requires a real or complex element type"))
    (execute-operation :convert nil (list input) :operator (gpu:type-spec type) :rounding rounding)))
(defun convert! (out input &key (rounding :nearest-even))
  "Convert INPUT into OUT's element type; return OUT."
  (unless (gpu:strided-view-p input) (gpu-fail "conversion requires an input view"))
  (execute-operation :convert out (list input) :operator (checked-element out) :rounding rounding))
