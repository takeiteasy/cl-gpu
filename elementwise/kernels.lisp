(in-package #:cl-gpu/elementwise)

(defvar *kernels* (make-hash-table :test #'equal))
(defvar *kernel-lock* (bordeaux-threads:make-lock "elementwise kernels"))

(defun sigmoid-code (x)
  `(if (>= ,x 0.0) (/ 1.0 (+ 1.0 (cl:exp (- ,x))))
       (let ((z (cl:exp ,x))) (/ z (+ 1.0 z)))))

(defun operation-code (operation element values operator)
  (destructuring-bind (a &optional b c) values
    (case operation
      (:copy a)
      (:convert (converted-code element operator a 'rounding))
      (:compare `(if (,(ecase operator (:eq '=) (:ne '/=) (:lt '<) (:le '<=) (:gt '>) (:ge '>=)) ,a ,b)
                     (gpu:convert gpu:u8 1) (gpu:convert gpu:u8 0)))
      (:select `(if (/= ,a 0) ,b ,c))
      ((:add :subtract :multiply :negate :abs)
       (let* ((op (ecase operation (:add '+) (:subtract '-) (:multiply '*) (:negate '-) (:abs 'cl:abs)))
              (integerp (not (float-element-p element))))
         (if integerp
             (let* ((u (unsigned-element element))
                    (ua `(gpu:convert gpu:u64 (gpu:bitcast ,u ,a)))
                    (ub (when b `(gpu:convert gpu:u64 (gpu:bitcast ,u ,b))))
                    (expr (case operation
                            (:negate `(- (gpu:convert gpu:u64 0) ,ua))
                            (:abs (if (gpu::signed-type-p (gpu:parse-type element))
                                      `(if (< ,a 0) (- (gpu:convert gpu:u64 0) ,ua) ,ua) ua))
                            (otherwise `(,op ,ua ,ub)))))
               `(gpu:bitcast ,element (gpu:convert ,u ,expr)))
             (if b `(,op ,a ,b) `(,op ,a)))))
      (:divide
       (if (float-element-p element) `(/ ,a ,b)
           `(if (= ,b 0) (progn (%record-error status) ,a)
                ,(if (gpu::signed-type-p (gpu:parse-type element))
                     `(if (and (= ,a ,(- (expt 2 (1- (gpu:scalar-type-bits (gpu:parse-type element))))))
                               (= ,b -1)) ,a (/ ,a ,b))
                     `(/ ,a ,b)))))
      (:reciprocal `(/ 1.0 ,a))
      (:sigmoid (sigmoid-code a))
      (:silu `(* ,a ,(sigmoid-code a)))
      (:gelu `(* (* 0.5 ,a)
                 (+ 1.0 (cl:tanh (* 0.79788456080286535587989211986876d0
                                   (+ ,a (* 0.044715d0 (* (* ,a ,a) ,a))))))))
      (:clamp `(if (> ,b ,c) (progn (%record-error status) ,a) (gpu:clamp ,a ,b ,c)))
      (otherwise `(,(ecase operation (:min 'cl:min) (:max 'cl:max) (:sqrt 'cl:sqrt)
                          (:exp 'cl:exp) (:log 'cl:log) (:sin 'cl:sin) (:cos 'cl:cos)
                          (:tanh 'cl:tanh)) ,@values)))))

(defun build-kernel (operation element result-element kinds operator checked)
  (let* ((rank 'rank) (metadata 'metadata)
         (parameters `((out (gpu:ptr ,(if (eq operation :convert) (conversion-storage result-element) result-element) :global))
                       (,metadata (gpu:ptr gpu:i64 :global)) (,rank gpu:u32)
                       (count gpu:i64) (start gpu:i64) (obase gpu:i64)))
         (bindings '((position start) (lane (gpu:convert gpu:i64 (gpu:global-id 0)))))
         (offsets '((oi obase))) (values nil) (arguments nil)
         (width (1+ (length kinds))))
    (loop for kind in kinds for i from 0
          for x = (gensym "INPUT")
          for base = (gensym "BASE")
          for at = (gensym "AT")
          for value = (gensym "VALUE")
          for type = (if (and (eq operation :select) (zerop i)) 'gpu:u8 element)
          do (if (eq kind :view)
                 (progn
                   (setf parameters (append parameters `((,x (gpu:ptr ,(if (eq operation :convert) (conversion-storage type) type) :global)) (,base gpu:i64))))
                   (push (list at base) offsets)
                   (push `(,value ,(if (and (float-element-p type) (not (member operation '(:copy :convert :select))))
                                      `(gpu:convert ,(compute-element type) (aref ,x ,at)) `(aref ,x ,at))) arguments))
                 (progn
                   (setf parameters (append parameters `((,x ,type))))
                   (push `(,value ,(if (and (float-element-p type) (not (member operation '(:copy :convert :select))))
                                      `(gpu:convert ,(compute-element type) ,x) x)) arguments)))
             (push value values))
    (setf width (1+ (length offsets)))
    (when checked (setf parameters (append parameters '((status (gpu:ptr gpu:u32 :global))))))
    (when (eq operation :convert) (setf parameters (append parameters '((rounding gpu:u32)))))
    ;; TODO: O(rank) coordinate decoding per element; coalesce axes and specialize contiguous layouts (#76).
    (let* ((values (nreverse values))
           (expression (if (and (eq operation :clamp) (not checked))
                           `(gpu:clamp ,@values)
                           (operation-code operation element values operator)))
           (expression (if (and (float-element-p element)
                                (not (member operation '(:convert :compare :copy :select))))
                           `(gpu:convert ,result-element ,expression) expression))
           (form
             `(progn
                (let ,bindings
                  (when (< lane (- count start))
                    (incf position lane)
                    (let ,(reverse offsets)
                      (let ((q position))
                        (gpu:for (axis (gpu:convert gpu:u32 0) (< axis ,rank) (incf axis))
                          (let* ((row (* (gpu:convert gpu:i64 axis) ,width))
                                 (dimension (aref ,metadata row))
                                 (coordinate (rem q dimension)))
                            ,@(loop for offset in (reverse offsets) for column from 1
                                    collect `(incf ,(first offset)
                                                    (* coordinate (aref ,metadata (+ row ,column)))))
                            (setf q (/ q dimension)))))
                      (let* ,(nreverse arguments)
                        ,@(when (and checked (eq operation :convert))
                            `((when (/= ,(first values) ,(first values)) (%record-error status))))
                        (setf (aref out oi) ,expression))))))))
      (gpu::make-gpu-kernel 'elementwise parameters form :precise-math t))))

(defun operation-kernel (operation element result-element kinds operator checked)
  (let ((key (list operation element result-element kinds operator checked)))
    (bordeaux-threads:with-lock-held (*kernel-lock*)
      (or (gethash key *kernels*)
          (setf (gethash key *kernels*)
                (build-kernel operation element result-element kinds operator checked))))))
