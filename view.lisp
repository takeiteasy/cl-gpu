(in-package #:cl-gpu)

(defstruct (strided-view (:constructor %make-strided-view (data shape strides offset)))
  (data nil :read-only t)
  (shape #() :read-only t)
  (strides #() :read-only t)
  (offset 0 :read-only t))

(defun shape-size (shape)
  (reduce #'* shape :initial-value 1))

(defun row-strides (shape)
  (let ((strides (make-array (length shape))) (step 1))
    (loop for axis downfrom (1- (length shape)) to 0
          do (setf (aref strides axis) step)
             (setf step (* step (aref shape axis))))
    strides))

(defun view-bounds (view)
  (let ((low (strided-view-offset view)) (high (strided-view-offset view)))
    (loop for dimension across (strided-view-shape view)
          for stride across (strided-view-strides view)
          for delta = (* (max 0 (1- dimension)) stride)
          do (incf low (min 0 delta)) (incf high (max 0 delta)))
    (values low high)))

(defun check-view (view)
  (unless (strided-view-p view) (gpu-fail "expected a strided-view, got ~s" view))
  (let ((data (strided-view-data view)) (shape (strided-view-shape view))
        (strides (strided-view-strides view)) (offset (strided-view-offset view)))
    (unless (typep data 'gpu-array) (gpu-fail "view data must be a gpu-array"))
    (cl-gpu::live-buffer data)
    (unless (and (vectorp shape) (vectorp strides) (= (length shape) (length strides))
                 (typep (length shape) '(unsigned-byte 32))
                 (every (lambda (d) (typep d '(integer 0 #.(1- (expt 2 63))))) shape)
                 (every (lambda (s) (typep s '(signed-byte 64))) strides)
                 (typep offset '(integer 0 #.(1- (expt 2 63))))
                 (typep (shape-size shape) '(integer 0 #.(1- (expt 2 63))))
                 (every (lambda (s) (typep s '(signed-byte 64))) (row-strides shape)))
      (gpu-fail "invalid shape, strides or offset"))
    (multiple-value-bind (low high) (view-bounds view)
      (unless (if (zerop (shape-size shape))
                  (<= offset (gpu-array-length data))
                  (and (<= 0 low) (< high (gpu-array-length data))))
        (gpu-fail "strided view exceeds its data array"))
      (let ((base (nth-value 1 (cl-gpu::array-root-and-offset data))))
        (unless (and (typep (+ base offset) '(signed-byte 64))
                     (typep (+ base low) '(signed-byte 64))
                     (typep (+ base high) '(signed-byte 64)))
          (gpu-fail "strided view exceeds signed 64-bit indexing")))))
  view)

(defun make-strided-view (data shape &key strides (offset 0))
  "Borrow DATA with SHAPE, signed element STRIDES and OFFSET. Metadata is copied."
  (unless (and (typep shape 'sequence) (or (null strides) (typep strides 'sequence)))
    (gpu-fail "shape and strides must be sequences"))
  (let* ((shape (coerce shape 'vector))
         (strides (if strides (coerce strides 'vector)
                      (if (every (lambda (d) (typep d '(integer 0))) shape)
                          (row-strides shape)
                          (gpu-fail "dimensions must be nonnegative integers")))))
    (check-view (%make-strided-view data (copy-seq shape) (copy-seq strides) offset))))

(defun view-element (view)
  (type-spec (gpu-array-element-type (strided-view-data view))))

(defun float-view-element (view &optional f64-p)
  (let ((type (gpu-array-element-type (strided-view-data view))))
    (unless (or (member type (mapcar #'parse-type '(f32 f16 bf16)))
                (and f64-p (eq type (parse-type 'f64))))
      (gpu-fail "expected a supported floating strided view"))
    (scalar-type-name type)))

(defun view-root (view)
  (cl-gpu::array-root-and-offset (strided-view-data view)))

(defun view-base (view)
  (+ (strided-view-offset view) (nth-value 1 (view-root view))))

(defun map-view-offsets (function view)
  (let* ((shape (strided-view-shape view)) (strides (strided-view-strides view))
         (rank (length shape)))
    (labels ((visit (axis offset)
               (if (= axis rank) (funcall function offset)
                   (dotimes (i (aref shape axis))
                     (visit (1+ axis) (+ offset (* i (aref strides axis))))))))
      (visit 0 (strided-view-offset view)))))

(defun unique-view-p (view)
  (when (<= (shape-size (strided-view-shape view)) 1) (return-from unique-view-p t))
  (let ((axes (sort (loop for d across (strided-view-shape view)
                         for s across (strided-view-strides view)
                         when (> d 1) collect (cons (abs s) d)) #'< :key #'car))
        (extent 0))
    (when (loop for (stride . dimension) in axes always (> stride extent)
                do (incf extent (* stride (1- dimension))))
      (return-from unique-view-p t)))
  ;; TODO: O(size) host workspace; add arithmetic uniqueness proofs (#75).
  (let ((seen (make-hash-table :test #'eql)))
    (map-view-offsets (lambda (offset)
                       (when (gethash offset seen) (return-from unique-view-p nil))
                       (setf (gethash offset seen) t)) view)
    t))

(defun views-overlap-p (a b)
  (and (eq (view-root a) (view-root b))
       (plusp (shape-size (strided-view-shape a)))
       (plusp (shape-size (strided-view-shape b)))
       (multiple-value-bind (al ah) (view-bounds a)
         (multiple-value-bind (bl bh) (view-bounds b)
           (let ((ab (nth-value 1 (view-root a))) (bb (nth-value 1 (view-root b))))
             (and (<= (+ ab al) (+ bb bh)) (<= (+ bb bl) (+ ab ah))))))))
