(defpackage #:cl-gpu/elementwise/tests
  (:use #:cl #:fiveam)
  (:local-nicknames (#:gpu #:cl-gpu) (#:ew #:cl-gpu/elementwise))
  (:export #:run-tests #:run-metal-tests))
(in-package #:cl-gpu/elementwise/tests)

(def-suite :cl-gpu/elementwise)
(def-suite :cl-gpu/elementwise/metal)
(in-suite :cl-gpu/elementwise)
(defun run-tests () (run! :cl-gpu/elementwise))
(defun run-metal-tests () (run! :cl-gpu/elementwise/metal))

(defclass mock-device () ((launches :initform 0 :accessor launches)
                         (allocations :initform 0 :accessor allocations)))
(defmethod gpu:device-allocate ((device mock-device) bytes)
  (declare (ignore bytes))
  (incf (allocations device)) (make-array 1 :element-type '(unsigned-byte 8)))
(defmethod gpu:device-free ((device mock-device) buffer)
  (declare (ignore buffer)) (decf (allocations device)))
(defmethod gpu:device-store ((device mock-device) buffer sequence type offset)
  (declare (ignore buffer sequence type offset)))
(defmethod gpu:device-target ((device mock-device)) :metal)
(defmethod gpu:device-prepare ((device mock-device) source entry &key precise-math)
  (declare (ignore entry precise-math)) source)
(defmethod gpu:device-launch ((device mock-device) prepared arguments grid group)
  (declare (ignore prepared arguments grid group)) (incf (launches device)))

(defmacro with-result ((name form) &body body)
  `(let ((,name ,form))
     (unwind-protect (progn ,@body) (gpu:free (gpu:strided-view-data ,name)))))

(test broadcast-shapes
  (let ((device (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 12 :device device))
      (let ((a (gpu:make-strided-view data '(2 1 3)))
            (b (gpu:make-strided-view data '(4 1))))
        (with-result (out (ew:add a b))
          (is (equalp #(2 4 3) (gpu:strided-view-shape out))))
        (with-result (out (ew:add a 2)) (is (= 6 (gpu:gpu-array-length (gpu:strided-view-data out)))))))
    (is (zerop (allocations device)))))

(test invalid-and-empty-calls
  (let ((device (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 16 :device device))
      (let ((a (gpu:make-strided-view data '(2 3)))
            (bad (gpu:make-strided-view data '(4)))
            (overlap (gpu:make-strided-view data '(2 3) :strides '(0 1))))
        (signals gpu:gpu-error (ew:add a bad))
        (signals gpu:gpu-error (ew:add! nil a 1))
        (signals gpu:gpu-error (ew:compare! nil :eq a 1))
        (signals gpu:gpu-error (ew:add! overlap a 1))
        (signals gpu:gpu-error (ew:add 1 2))
        (signals gpu:gpu-error (ew:compare :bogus a 1))
        (signals gpu:gpu-error (ew:select a a a))
        (signals gpu:gpu-error (ew:clamp a 3 2))
        (signals gpu:gpu-error (ew:convert a 'gpu:i32 :rounding :bogus))
        (signals gpu:gpu-error (ew:convert a 'gpu:f64))
        (signals gpu:gpu-error (ew:convert a '(gpu:vec gpu:f32 2)))
        (gpu:with-gpu-array (integer (gpu:make-gpu-array 6 :element-type 'gpu:i32 :device device))
          (let ((v (gpu:make-strided-view integer '(2 3))))
            (signals gpu:gpu-error (ew:exp v))
            (signals gpu:gpu-error (ew:add a v))
            (signals gpu:gpu-error (ew:convert v 'gpu:f16))))
        (is (zerop (launches device)))
        (let ((empty (gpu:make-strided-view data '(0 3))))
          (with-result (out (ew:add empty (gpu:make-strided-view data '(1 3))))
            (is (equalp #(0 3) (gpu:strided-view-shape out))))
          (signals gpu:gpu-error (ew:add empty bad)))
        (is (zerop (launches device)))
        (gpu:free data)
        (signals gpu:gpu-error (ew:add a 1))))
    (is (zerop (allocations device)))))

(test generated-kernels-lower
  (dolist (element ew::*elements*)
    (dolist (operation '(:add :subtract :multiply :divide :min :max :negate :abs :compare :select :clamp :copy))
      (let* ((count (case operation ((:negate :abs :copy) 1) ((:select :clamp) 3) (otherwise 2)))
             (kernel (ew::operation-kernel operation element
                                           (if (eq operation :compare) 'gpu:u8 element)
                                           (make-list count :initial-element :view)
                                           (when (eq operation :compare) :lt)
                                           (or (eq operation :clamp)
                                               (and (eq operation :divide) (not (ew::float-element-p element)))))))
        (is (stringp (gpu:kernel-source (gpu:kernel-ir kernel) (if (eq element 'gpu:f64) :opencl :metal))))))
    (when (ew::float-element-p element)
      (dolist (operation '(:sqrt :reciprocal :exp :log :sin :cos :tanh :sigmoid :silu :gelu))
        (is (stringp (gpu:kernel-source
                      (gpu:kernel-ir (ew::operation-kernel operation element element '(:view) nil nil)) (if (eq element 'gpu:f64) :opencl :metal))))))
    (dolist (destination ew::*elements*)
      (unless (and (or (member element '(gpu:f16 gpu:bf16)) (member destination '(gpu:f16 gpu:bf16)))
                   (not (and (ew::float-element-p element) (ew::float-element-p destination))))
        (is (stringp (gpu:kernel-source
                      (gpu:kernel-ir (ew::operation-kernel :convert element destination '(:view) destination
                                                           (and (ew::float-element-p element)
                                                                (not (ew::float-element-p destination))))) (if (or (eq element 'gpu:f64) (eq destination 'gpu:f64)) :opencl :metal))))))))

(test aliases-and-cleanup
  (let ((device (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 16 :device device))
      (let ((a (gpu:make-strided-view data '(2 3))))
        (is (eq a (ew:add! a a 1)))
        (is (= 2 (launches device)))
        (is (= 1 (allocations device)))))
    (is (zerop (allocations device)))))

(test launch-boundaries-and-metadata-limits
  (let ((device (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 16776961 :device device))
      (with-result (out (ew:negate (gpu:make-strided-view data '(16776961))))
        (is (= 16776961 (gpu:gpu-array-length (gpu:strided-view-data out)))))
      (is (= 2 (launches device)))
      (signals gpu:gpu-error (gpu:make-strided-view data (list (expt 2 63))))
      (signals gpu:gpu-error (gpu:make-strided-view data '(2) :strides (list (expt 2 63)))))
    (is (zerop (allocations device)))))

(defclass failing-device (mock-device) ())
(defmethod gpu:device-prepare ((device failing-device) source entry &key precise-math)
  (declare (ignore source entry precise-math)) (gpu::gpu-fail "injected compilation failure"))

(test failures-release-owned-storage
  (let ((device (make-instance 'failing-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 6 :device device))
      (let ((input (gpu:make-strided-view data '(2 3))))
        (signals gpu:gpu-error (ew:add input 1))
        (is (= 1 (allocations device)))
        (signals gpu:gpu-error (ew:add! input input 1))
        (is (= 1 (allocations device)))))
    (is (zerop (allocations device)))))

(test view-types-devices-and-window-offsets
  (let ((device (make-instance 'mock-device)) (other (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 20 :device device))
      (gpu:with-gpu-array (foreign (gpu:make-gpu-array 6 :device other))
        (let* ((window (gpu:make-gpu-array-view data 10 :offset 5))
               (input (gpu:make-strided-view window '(2 3) :offset 2))
               (out (gpu:make-strided-view foreign '(2 3))))
          (is (= 7 (gpu::view-base input)))
          (signals gpu:gpu-error (ew:add input out))
          (signals gpu:gpu-error (ew:add! out input 1))
          (gpu:with-gpu-array (vectors (gpu:make-gpu-array 6 :element-type '(gpu:vec gpu:f32 2) :device device))
            (signals gpu:gpu-error (ew:negate (gpu:make-strided-view vectors '(6)))))
          (is (zerop (launches device)))
          (gpu:free foreign)
          (signals gpu:gpu-error (ew:add! out input 1)))))
    (is (zerop (allocations device)))
    (is (zerop (allocations other)))))

(test native-f64-rejected-before-work
  (let ((device (make-instance 'mock-device)))
    (dolist (size '(0 3))
      (gpu:with-gpu-array (data (gpu:make-gpu-array size :element-type 'gpu:f64 :device device))
        (let ((input (gpu:make-strided-view data (list size))))
          (dolist (function (list #'ew:negate #'ew:abs #'ew:sqrt #'ew:reciprocal #'ew:exp
                                 #'ew:log #'ew:sin #'ew:cos #'ew:tanh #'ew:sigmoid #'ew:silu #'ew:gelu))
            (signals gpu:gpu-unsupported-capability (funcall function input)))
          (dolist (function (list #'ew:add #'ew:subtract #'ew:multiply #'ew:divide #'ew:min #'ew:max))
            (signals gpu:gpu-unsupported-capability (funcall function input 1d0)))
          (signals gpu:gpu-unsupported-capability (ew:clamp input 0d0 1d0))
          (signals gpu:gpu-unsupported-capability (ew:compare :eq input 1d0))
          (signals gpu:gpu-unsupported-capability (ew:add! input input 1d0))
          (signals gpu:gpu-unsupported-capability (ew:convert input 'gpu:f32))
          (is (= 1 (allocations device)))))
      (gpu:with-gpu-array (data (gpu:make-gpu-array size :device device))
        (signals gpu:gpu-unsupported-capability (ew:convert (gpu:make-strided-view data (list size)) 'gpu:f64))
        (is (= 1 (allocations device)))))
    (is (zerop (launches device)))
    (is (zerop (allocations device)))))

(defclass f64-device (mock-device) ())
(defmethod gpu:device-target ((device f64-device)) :opencl)
(defmethod gpu:device-native-type-p ((device f64-device) element)
  (eq (gpu:parse-type element) (gpu:parse-type 'gpu:f64)))

(test f64-source-and-scalar-precision
  (let ((device (make-instance 'f64-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 3 :element-type 'gpu:f64 :device device))
      (with-result (out (ew:add (gpu:make-strided-view data '(3)) 16777217d0))
        (is (= 1 (launches device)))))
    (is (zerop (allocations device))))
  (is (= 16777217d0 (ew::scalar-value 16777217d0 'gpu:f64)))
  (let ((source (gpu:kernel-source
                  (gpu:kernel-ir (ew::operation-kernel :gelu 'gpu:f64 'gpu:f64 '(:view) nil nil)) :opencl)))
    (is (search "double" source))
    (is (not (search "(float)" source)))
    (is (search "0.044715" source))))

(defclass failing-f64-device (f64-device) ())
(defmethod gpu:device-prepare ((device failing-f64-device) source entry &key precise-math)
  (declare (ignore source entry precise-math))
  (gpu::gpu-fail "injected f64 compilation failure"))

(test f64-failures-release-scratch-metadata-and-status
  (let ((device (make-instance 'failing-f64-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 3 :element-type 'gpu:f64 :device device))
      (let ((input (gpu:make-strided-view data '(3))))
        (signals gpu:gpu-error (ew:add input 1d0))
        (is (= 1 (allocations device)))
        (signals gpu:gpu-error (ew:add! input input 1d0))
        (is (= 1 (allocations device)))
        (signals gpu:gpu-error (ew:convert input 'gpu:i64))
        (is (= 1 (allocations device)))
        (gpu:with-gpu-array (mask (gpu:make-gpu-array 3 :element-type 'gpu:u8 :device device))
          (signals gpu:gpu-error (ew:select (gpu:make-strided-view mask '(3)) input 16777217d0)))))
    (is (zerop (launches device)))
    (is (zerop (allocations device)))))

(test unsupported-f64-condition-and-mask-conversions
  (let ((device (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 0 :element-type 'gpu:f64 :device device))
      (gpu:with-gpu-array (mask (gpu:make-gpu-array 0 :element-type 'gpu:u8 :device device))
        (gpu:with-gpu-array (single (gpu:make-gpu-array 0 :device device))
          (let ((input (gpu:make-strided-view data '(0)))
                (mask-view (gpu:make-strided-view mask '(0)))
                (output (gpu:make-strided-view single '(0))))
            (handler-case (progn (ew:add input 1d0) (fail "unsupported f64 call succeeded"))
              (gpu:gpu-unsupported-capability (condition)
                (is (eq device (gpu:unsupported-capability-device condition)))
                (is (eq :add (gpu:unsupported-capability-operation condition)))
                (is (eq 'gpu:f64 (gpu:unsupported-capability-element-type condition)))))
            (signals gpu:gpu-unsupported-capability (ew:select mask-view input 1d0))
            (signals gpu:gpu-unsupported-capability (ew:convert! output input))
            (signals gpu:gpu-unsupported-capability (ew:convert! input output))
            (is (= 3 (allocations device)))))))
    (is (zerop (allocations device)))
    (is (zerop (launches device)))))
