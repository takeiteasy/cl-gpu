(defpackage #:cl-gpu/expressions/tests
  (:use #:cl #:fiveam)
  (:local-nicknames (#:gpu #:cl-gpu) (#:ex #:cl-gpu/expressions) (#:bt #:bordeaux-threads))
  (:export #:run-tests #:run-metal-tests))
(in-package #:cl-gpu/expressions/tests)

(def-suite :cl-gpu/expressions)
(def-suite :cl-gpu/expressions/metal)
(in-suite :cl-gpu/expressions)
(defun run-tests () (run! :cl-gpu/expressions))
(defun run-metal-tests () (run! :cl-gpu/expressions/metal))

(defclass mock-device ()
  ((allocations :initform 0 :accessor allocations)
   (preparations :initform 0 :accessor preparations)
   (launches :initform 0 :accessor launches)
   (waits :initform 0 :accessor waits)
   (grids :initform nil :accessor grids)
   (fail-at :initform nil :initarg :fail-at :accessor fail-at)
   (events :initform nil :accessor events)))
(defmethod gpu:device-target ((device mock-device)) :metal)
(defmethod gpu:device-allocate ((device mock-device) bytes)
  (when (eq (fail-at device) :allocate) (error 'gpu:gpu-error :message "injected allocation failure"))
  (incf (allocations device)) (make-array (min bytes 8) :element-type '(unsigned-byte 8) :initial-element 0))
(defmethod gpu:device-free ((device mock-device) buffer)
  (declare (ignore buffer)) (decf (allocations device)))
(defmethod gpu:device-store ((device mock-device) buffer sequence type offset)
  (declare (ignore buffer sequence type offset)) (push :upload (events device))
  (when (eq (fail-at device) :upload) (error 'gpu:gpu-error :message "injected upload failure")))
(defmethod gpu:device-load ((device mock-device) buffer sequence type offset)
  (declare (ignore buffer sequence type offset)) (error "unexpected tensor/status download"))
(defmethod gpu:device-prepare ((device mock-device) source entry &key precise-math)
  (declare (ignore entry))
  (assert precise-math)
  (incf (preparations device)) (push :prepare (events device))
  (when (eq (fail-at device) :prepare) (error 'gpu:gpu-error :message "injected compilation failure"))
  source)
(defmethod gpu:device-launch ((device mock-device) prepared arguments grid group)
  (declare (ignore prepared arguments group))
  (push grid (grids device))
  (incf (launches device)) (push :launch (events device))
  (when (or (eq (fail-at device) :launch)
            (eql (fail-at device) (launches device)))
    (error 'gpu:gpu-error :message "injected launch failure")))
(defmethod gpu:device-synchronize ((device mock-device))
  (incf (waits device)) (push :wait (events device))
  (when (eq (fail-at device) :wait) (error 'gpu:gpu-error :message "injected completion failure")))

(defmacro with-result ((name form) &body body)
  `(let ((,name ,form))
     (unwind-protect (progn ,@body) (gpu:free (gpu:strided-view-data ,name)))))

(test plan-validation
  (dolist (form '((:unknown a) (:add) (:sqrt a a) (:select a a a) (:add a . 1)
                  (:add (:lt a 0) a) (:lt a 0) (:add a missing)))
    (signals gpu:gpu-error (ex:make-expression-plan '(a) form)))
  (dolist (parameters '((a a) (t) (:a) (nil) (&rest) (a . b)))
    (signals gpu:gpu-error (ex:make-expression-plan parameters 1)))
  (let ((definition (list :add 'a 1)))
    (let ((plan (ex:make-expression-plan '(a) definition)))
      (setf (car definition) :unknown)
      (is (eq :add (car (ex::expression-plan-body plan))))))
  (let ((cycle (list :abs nil)))
    (setf (second cycle) cycle)
    (signals gpu:gpu-error (ex:make-expression-plan '(a) cycle))))

(test metadata-validation-and-empty-results
  (let ((device (make-instance 'mock-device)) (other (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 20 :device device))
      (let ((plan (ex:make-expression-plan '(a b unused) '(:add a b)))
            (a (gpu:make-strided-view data '(2 1 3)))
            (b (gpu:make-strided-view data '(4 1))))
        (multiple-value-bind (shape element result-device) (ex:expression-result-info plan (list a b nil))
          (is (equalp #(2 4 3) shape)) (is (eq 'gpu:f32 element)) (is (eq device result-device)))
        (is (= 1 (allocations device))) (is (zerop (launches device)))
        (let ((operands (vector a 2 nil)))
          (ex:expression-result-info plan operands)
          (is (eql 2 (aref operands 1))))
        (signals gpu:gpu-error (ex:execute-expression plan (list a b)))
        (signals gpu:gpu-error (ex:execute-expression plan '(1 2 nil)))
        (signals gpu:gpu-error (ex:execute-expression plan (list a b nil) :keepdims t))
        (signals gpu:gpu-error (ex:execute-expression plan (list a b nil) :axis '(0 0)))
        (signals gpu:gpu-error (ex:execute-expression! nil plan (list a b nil)))
        (gpu:with-gpu-array (foreign (gpu:make-gpu-array 3 :device other))
          (signals gpu:gpu-error (ex:execute-expression plan (list a (gpu:make-strided-view foreign '(3)) nil))))
        (dolist (element '(gpu:i32 gpu:f64))
          (gpu:with-gpu-array (bad (gpu:make-gpu-array 3 :element-type element :device device))
            (signals gpu:gpu-error (ex:execute-expression plan (list a (gpu:make-strided-view bad '(3)) nil))))))
      (let ((plan (ex:make-expression-plan '(a) '(:add a 1))))
        (with-result (out (ex:execute-expression plan (list (gpu:make-strided-view data '(0 3)))))
          (is (equalp #(0 3) (gpu:strided-view-shape out))))
        (is (zerop (launches device))))
      (let* ((input (gpu:make-strided-view data '(2 0)))
             (plan (ex:make-expression-plan '(a) '(:minimum a))))
        (signals gpu:gpu-error (ex:execute-expression plan (list input) :axis -1)))
      (let ((plan (ex:make-expression-plan '(a) '(:sum (:maximum a)))))
        (with-result (out (ex:execute-expression plan (list (gpu:make-strided-view data '(2 0))) :axis -1))
          (is (equalp #(2) (gpu:strided-view-shape out))))))
    (is (zerop (allocations device))) (is (zerop (allocations other)))))

(test generated-plans-and-reuse
  (let ((device (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 24 :device device))
      (dolist (body '((:add (:multiply a b) c)
                      (:sum (:select (:gt a 0) (:sqrt a) b))
                      (:divide a (:sum a))
                      (:select (:gt a 0) (:sum a) (:maximum (:add a 1)))
                      (:select (:gt (:sum a) 0) (:argmin a) (:argmax a))
                      (:sum (:add a (:prod a)))
                      (:argmin (:subtract a 1))))
        (let* ((plan (ex:make-expression-plan '(a b c) body))
               (operands (list (gpu:make-strided-view data '(2 3)) 2 1)))
          (with-result (result (ex:execute-expression plan operands :axis -1))
            (is (gpu:strided-view-p result)))
          (let ((prepared (preparations device)))
            (with-result (result (ex:execute-expression plan (list (gpu:make-strided-view data '(4 3) :strides '(3 -1) :offset 2) 3 2)
                                                       :axis -1))
              (is (gpu:strided-view-p result)))
            (is (= prepared (preparations device)))))))
    (is (zerop (allocations device)))))

(test staging-and-failure-cleanup
  (dolist (failure '(:allocate :upload :prepare :launch :wait nil 2))
    (let ((device (make-instance 'mock-device)))
      (gpu:with-gpu-array (data (gpu:make-gpu-array 6 :device device))
        (setf (fail-at device) failure)
        (let ((input (gpu:make-strided-view data '(2 3)))
              (plan (ex:make-expression-plan '(a) '(:add a 1))))
          (if failure
              (signals gpu:gpu-error (ex:execute-expression! input plan (list input)))
              (progn
                (is (eq input (ex:execute-expression! input plan (list input))))
                (is (equal '(:launch :wait :launch :wait)
                           (remove-if-not (lambda (e) (member e '(:launch :wait))) (reverse (events device)))))))
          (when (eq failure :prepare) (is (zerop (launches device))))
          (when (member failure '(:launch :wait)) (is (= 1 (launches device))))
          (is (= 1 (allocations device)))
          (when failure
            (setf (fail-at device) nil)
            (with-result (out (ex:execute-expression plan (list input))) (is (gpu:strided-view-p out))))))
      (is (zerop (allocations device))))))

(test destination-and-lifetime-validation
  (let ((device (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 12 :device device))
      (let ((plan (ex:make-expression-plan '(a) '(:sum a)))
            (input (gpu:make-strided-view data '(2 3))))
        (signals gpu:gpu-error (ex:execute-expression! input plan (list input) :axis -1))
        (signals gpu:gpu-error (ex:execute-expression! (gpu:make-strided-view data '(2) :strides '(0)) plan (list input) :axis -1))
        (is (zerop (launches device)))
        (gpu:free data)
        (signals gpu:gpu-error (ex:expression-result-info plan (list input)))))))

(defclass unsupported-device (mock-device) ())
(defmethod gpu:device-target ((device unsupported-device)) :cuda)
(defclass small-device (mock-device) ())
(defmethod gpu:device-shared-memory-limit ((device small-device)) 4)

(test capability-failures-before-launches
  (dolist (class '(unsupported-device small-device))
    (let ((device (make-instance class)))
      (gpu:with-gpu-array (data (gpu:make-gpu-array 6 :device device))
        (let ((input (gpu:make-strided-view data '(2 3))))
          (signals gpu:gpu-error
            (ex:execute-expression (ex:make-expression-plan '(a) '(:add a (:sum a))) (list input) :axis -1))
          (is (zerop (launches device))) (is (= 1 (allocations device)))))
      (is (zerop (allocations device))))))

(test launch-boundaries
  (let ((device (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 16776961 :device device))
      (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) '(:add a 1))
                                              (list (gpu:make-strided-view data '(16776961)))))
        (is (equal '(16776960 1) (mapcar #'car (reverse (grids device))))))
      (setf (grids device) nil)
      (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) '(:sum a))
                                              (list (gpu:make-strided-view data '(65536 1))) :axis -1))
        (is (equal '(65536 16776960 256) (mapcar #'car (reverse (grids device)))))))
    (is (zerop (allocations device)))))

(test variants-across-ranks-axes-and-devices
  (let ((plan (ex:make-expression-plan '(a) '(:sum a))))
    (dotimes (i 2)
      (let ((device (make-instance 'mock-device)))
        (gpu:with-gpu-array (data (gpu:make-gpu-array 6 :device device))
          (with-result (out (ex:execute-expression plan (list (gpu:make-strided-view data '(2 3))) :axis -1))
            (is (equalp #(2) (gpu:strided-view-shape out))))
          (let ((prepared (preparations device)))
            (with-result (out (ex:execute-expression plan (list (gpu:make-strided-view data '(6))) :axis 0))
              (is (equalp #() (gpu:strided-view-shape out))))
            (is (= prepared (preparations device)))))
        (is (zerop (allocations device)))))))

(test generated-arithmetic-kernels
  (dolist (body '((:add a) (:subtract a) (:divide a) (:min a) (:max a)
                  (:add a a a) (:subtract a a a) (:multiply a a a) (:divide a a a)
                  (:min a a a) (:max a a a) (:abs a) (:sqrt a) (:exp a) (:sin a)
                  (:cos a) (:log a) (:tanh a) (:sigmoid a) (:fma a a a)
                  (:select (:eq a 0) a 1) (:select (:ne a 0) a 1)
                  (:select (:lt a 0) a 1) (:select (:le a 0) a 1)
                  (:select (:gt a 0) a 1) (:select (:ge a 0) a 1)))
    (let ((device (make-instance 'mock-device)))
      (gpu:with-gpu-array (data (gpu:make-gpu-array 1 :device device))
        (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) body)
                                                (list (gpu:make-strided-view data '#()))))
          (is (equalp #() (gpu:strided-view-shape out)))))
      (is (zerop (allocations device))))))
