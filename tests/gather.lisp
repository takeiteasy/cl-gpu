(defpackage #:cl-gpu/gather/tests
  (:use #:cl #:fiveam)
  (:local-nicknames (#:gpu #:cl-gpu) (#:g #:cl-gpu/gather))
  (:export #:run-tests #:run-metal-tests))
(in-package #:cl-gpu/gather/tests)

(def-suite :cl-gpu/gather)
(def-suite :cl-gpu/gather/metal)
(in-suite :cl-gpu/gather)
(defun run-tests () (run! :cl-gpu/gather))
(defun run-metal-tests () (run! :cl-gpu/gather/metal))

(defstruct buffer bytes)
(defclass mock-device ()
  ((buffers :initform nil :accessor buffers)
   (events :initform nil :accessor events)
   (failure :initform nil :accessor failure)
   (fail-at :initform 1 :accessor fail-at)
   (attempts :initform 0 :accessor attempts)
   (bounds-error :initform nil :accessor bounds-error)))

(defun event (device kind &rest details)
  (push (cons kind details) (events device))
  (when (and (eq kind (failure device)) (= (incf (attempts device)) (fail-at device)))
    (gpu::gpu-fail "injected ~s failure" kind)))

(defmethod gpu:device-allocate ((device mock-device) bytes)
  (event device :allocate bytes)
  (let ((buffer (make-buffer :bytes bytes)))
    (push buffer (buffers device)) buffer))
(defmethod gpu:device-free ((device mock-device) buffer)
  (setf (buffers device) (remove buffer (buffers device))))
(defmethod gpu:device-store ((device mock-device) buffer sequence type offset)
  (declare (ignore sequence))
  (event device :store buffer type offset))
(defmethod gpu:device-load ((device mock-device) buffer sequence type offset)
  (event device :load buffer type offset (length sequence))
  (fill sequence (if (bounds-error device) 1 0)))
(defmethod gpu:device-target ((device mock-device)) :metal)
(defmethod gpu:device-prepare ((device mock-device) source entry &key precise-math)
  (declare (ignore source precise-math))
  (event device :prepare entry) entry)
(defmethod gpu:device-launch ((device mock-device) prepared arguments grid group)
  (event device :launch prepared arguments grid group))

(defmacro with-result ((name form) &body body)
  `(let ((,name ,form))
     (unwind-protect (progn ,@body) (gpu:free (gpu:strided-view-data ,name)))))

(defmacro with-operands ((device input indices &optional (shape ''(2 3)) (index-shape ''(2))) &body body)
  `(let ((,device (make-instance 'mock-device)))
     (gpu:with-gpu-array (data (gpu:make-gpu-array 32 :device ,device))
       (gpu:with-gpu-array (ids (gpu:make-gpu-array 8 :element-type 'gpu:i64 :device ,device))
         (let ((,input (gpu:make-strided-view data ,shape))
               (,indices (gpu:make-strided-view ids ,index-shape)))
           ,@body)))
     (is (null (buffers ,device)))))

(test shapes-and-scheduling
  (with-operands (device input indices)
    (dolist (axis '(0 -2 1 -1))
      (setf (events device) nil)
      (with-result (out (g:gather input indices :axis axis))
        (is (equalp (if (member axis '(0 -2)) #(2 3) #(2 2)) (gpu:strided-view-shape out)))
        (is (not (eq (gpu:strided-view-data input) (gpu:strided-view-data out)))))
      (is (= 1 (count :load (events device) :key #'car)))
      (is (= 2 (count :launch (events device) :key #'car))))
    (with-result (out (g:gather input (gpu:make-strided-view (gpu:strided-view-data indices) '()) :axis 1))
      (is (equalp #(2) (gpu:strided-view-shape out))))
    (with-result (out (g:gather input (gpu:make-strided-view (gpu:strided-view-data indices) '(2 2))))
      (is (equalp #(2 2 3) (gpu:strided-view-shape out))))))

(test metadata-validation-including-empty-calls
  (with-operands (device input indices)
    (dolist (axis '(2 -3 nil 0.5)) (signals gpu:gpu-error (g:gather input indices :axis axis)))
    (signals gpu:gpu-error (g:gather (gpu:make-strided-view (gpu:strided-view-data input) '()) indices))
    (signals gpu:gpu-error (g:gather input input))
    (signals gpu:gpu-error (g:gather input (gpu:make-strided-view (gpu:strided-view-data input) '(0))))
    (signals gpu:gpu-error (g:gather! nil input indices))
    (signals gpu:gpu-error (g:gather! (gpu:make-strided-view (gpu:strided-view-data input) '(2 3) :strides '(0 1)) input indices))
    (signals gpu:gpu-error (g:gather! (gpu:make-strided-view (gpu:strided-view-data input) '(3 2)) input indices))
    (signals gpu:gpu-error (g:gather! (gpu:make-strided-view (gpu:strided-view-data indices) '(2 3)) input indices))
    (let ((other (make-instance 'mock-device)))
      (gpu:with-gpu-array (foreign (gpu:make-gpu-array 6 :element-type 'gpu:i64 :device other))
        (signals gpu:gpu-error (g:gather input (gpu:make-strided-view foreign '(2)))))
      (gpu:with-gpu-array (foreign (gpu:make-gpu-array 6 :device other))
        (signals gpu:gpu-error (g:gather! (gpu:make-strided-view foreign '(2 3)) input indices))))
    (dolist (type '(gpu:f64 gpu:bool (gpu:vec gpu:f32 2)))
      (gpu:with-gpu-array (data (gpu:make-gpu-array 6 :element-type type :device device))
        (signals gpu:gpu-error (g:gather (gpu:make-strided-view data '(2 3)) indices))))
    (is (zerop (count :launch (events device) :key #'car)))
    (setf (aref (gpu:strided-view-shape input) 0) 100)
    (signals gpu:gpu-error (g:gather input indices))
    (setf (aref (gpu:strided-view-shape input) 0) 2)
    (gpu:free (gpu:strided-view-data indices))
    (signals gpu:gpu-error (g:gather input indices))))

(test empty-results-still-check-indices
  (with-operands (device input indices '(2 0))
    (setf (events device) nil)
    (with-result (out (g:gather input indices)) (is (equalp #(2 0) (gpu:strided-view-shape out))))
    (is (= 1 (count :launch (events device) :key #'car)))
    (is (= 1 (count :load (events device) :key #'car)))
    (setf (bounds-error device) t)
    (signals gpu:gpu-error (g:gather input indices))
    (is (= 2 (length (buffers device)))))
  (with-operands (device input indices '(0 3) '(0))
    (setf (events device) nil)
    (with-result (out (g:gather input indices)) (is (equalp #(0 3) (gpu:strided-view-shape out))))
    (is (null (remove :allocate (events device) :key #'car)))
    (signals gpu:gpu-error (g:gather! (gpu:make-strided-view (gpu:strided-view-data input) '(0 2)) input indices))))

(test aliases-stage-before-copy-and-only-load-status
  (with-operands (device input indices)
    (setf (events device) nil)
    (is (eq input (g:gather! input input indices)))
    (let* ((events (reverse (events device)))
           (launches (remove-if-not (lambda (e) (eq (car e) :launch)) events))
           (load (find :load events :key #'car)))
      (is (= 3 (length launches)))
      (is (< (position (second launches) events) (position load events) (position (third launches) events)))
      (is (= 1 (fifth load)))
      (is (= 4 (buffer-bytes (second load))))
      (is (not (eq (second load) (gpu::array-buffer (gpu:strided-view-data input)))))
      (is (not (eq (second load) (gpu::array-buffer (gpu:strided-view-data indices))))))
    (is (= 2 (length (buffers device))))))

(test failures-release-scratch-before-destination-writes
  (dolist (outp '(nil t))
    (dolist (kind '(:allocate :store :prepare :launch :load))
      (loop for at from 1 to (ecase kind (:allocate (if outp 6 5))
                                    ((:store :prepare :launch) (if outp 3 2)) (:load 1))
            do (with-operands (device input indices)
                 (setf (failure device) kind (fail-at device) at (events device) nil)
                 (signals gpu:gpu-error (if outp (g:gather! input input indices) (g:gather input indices)))
                 (is (= 2 (length (buffers device))))
                 (when (or (eq kind :load) (and (eq kind :launch) (< at 3)))
                   (is (notany (lambda (e) (and (eq (car e) :launch)
                                                (search "gather_copy" (second e)))) (events device))))))))
  (with-operands (device input indices)
    (setf (bounds-error device) t (events device) nil)
    (signals gpu:gpu-error (g:gather! input input indices))
    (is (= 2 (count :launch (events device) :key #'car)))
    (is (= 2 (length (buffers device)))))
  (with-operands (device input indices)
    (setf (failure device) :load)
    (signals gpu:gpu-error (g:gather input indices))
    (is (= 2 (length (buffers device))))))

(test window-offsets-and-launch-chunks
  (with-operands (device input indices)
    (let ((window (gpu:make-strided-view (gpu:make-gpu-array-view (gpu:strided-view-data input) 20 :offset 5)
                                         '(2 3) :offset 2)))
      (is (eq window (g:gather! window window indices)))
      (let* ((launch (find :launch (events device) :key #'car)) (args (third launch)))
        (is (= 7 (third (sixth args)))))))
  (let ((device (make-instance 'mock-device)))
    (gpu:with-gpu-array (data (gpu:make-gpu-array 16776961 :device device))
      (gpu:with-gpu-array (ids (gpu:make-gpu-array 1 :element-type 'gpu:u64 :device device))
        (with-result (out (g:gather (gpu:make-strided-view data '(1 16776961))
                                    (gpu:make-strided-view ids '())))
          (is (= 16776961 (gpu::shape-size (gpu:strided-view-shape out)))))
        (is (= 3 (count :launch (events device) :key #'car)))))
    (is (null (buffers device)))))

(test kernels-lower-for-all-formats
  (dolist (element g::*index-elements*)
    (is (stringp (gpu:kernel-source (gpu:kernel-ir (g::cached-kernel :indices element)) :metal))))
  (dolist (element g::*elements*)
    (dolist (operation '(:gather :copy))
      (is (stringp (gpu:kernel-source (gpu:kernel-ir (g::cached-kernel operation element)) :metal))))))

(test result-indexing-overflow-validates-before-allocation
  (with-operands (device input indices)
    (let ((source (gpu:make-strided-view (gpu:strided-view-data input) '(1 3037000500) :strides '(0 0)))
          (ids (gpu:make-strided-view (gpu:strided-view-data indices) '(3037000500) :strides '(0))))
      (setf (events device) nil)
      (signals gpu:gpu-error (g:gather source ids))
      (is (null (events device))))))
