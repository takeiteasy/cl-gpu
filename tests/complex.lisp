(in-package #:cl-gpu/elementwise/tests)
(in-suite :cl-gpu/elementwise)

(test complex-storage-and-kernel-contract
  (dolist (element '(gpu:c32 gpu:c64))
    (let ((device (make-instance 'mock-device)))
      (gpu:with-gpu-array (data (gpu:make-gpu-array 8 :element-type element :device device))
        (let* ((window (gpu:make-gpu-array-view data 2 :offset 3))
               (storage (gpu:gpu-array-storage-view window)))
          (is (eq (gpu:storage-type element) (gpu:gpu-array-element-type storage)))
          (is (= 3 (gpu:gpu-array-view-offset storage)))
          (is (= 2 (gpu:gpu-array-length storage)))
          (gpu:free storage)
          (is (not (null (gpu::live-buffer data)))))
        (is (= (if (eq element 'gpu:c32) 8 16) (gpu::element-bytes (gpu:gpu-array-element-type data))))
        (is (eq element (gpu:type-spec (gpu:gpu-array-element-type data))))
        (is (equal (list 'gpu:vec (ew::component-element element) 2)
                   (gpu:type-spec (gpu:storage-type element))))
        (let ((view (gpu:make-strided-view data '(0))))
          (signals gpu:gpu-error (ew:min view view))
          (signals gpu:gpu-error (ew:max view view))
          (signals gpu:gpu-error (ew:clamp view 0 1))
          (signals gpu:gpu-error (ew:sqrt view))
          (signals gpu:gpu-error (ew:exp view))
          (signals gpu:gpu-error (ew:compare :lt view view))
          (when (eq element 'gpu:c64)
            (signals gpu:gpu-unsupported-capability (ew:add view 1))
            (signals gpu:gpu-unsupported-capability (ew:realpart view))
            (signals gpu:gpu-unsupported-capability (ew:convert view 'gpu:f32))))
        (is (zerop (launches device))))
      (is (zerop (allocations device)))))
  (signals gpu:kernel-type-error (gpu:parse-type '(gpu:ptr gpu:c32 :global)))
  (signals gpu:gpu-error (gpu:to-device #(1f0 2f0) :flat t)))

(test complex-generated-kernels
  (dolist (element '(gpu:c32 gpu:c64))
    (let ((target (if (eq element 'gpu:c32) :metal :opencl)))
      (dolist (operation '(:add :subtract :multiply :divide :negate :abs :conjugate :realpart :imagpart :compare :select :copy))
        (let* ((result (case operation (:compare 'gpu:u8) ((:abs :realpart :imagpart) (ew::component-element element))
                             (otherwise element)))
               (n (case operation ((:add :subtract :multiply :divide :compare) 2) (:select 3) (otherwise 1))))
          (is (stringp (gpu:kernel-source
                        (gpu:kernel-ir (ew::operation-kernel operation element result
                                                            (make-list n :initial-element :view) :eq nil)) target)))))
      (dolist (real ew::*elements*)
        (dolist (pair (list (list real element) (list element real)))
          (is (stringp (gpu:kernel-source
                        (gpu:kernel-ir (ew::operation-kernel :convert (first pair) (second pair) '(:view)
                                                            (second pair) (eq (first pair) element)))
                        (if (eq real 'gpu:f64) :opencl target)))))))))

(defun complex-device-checks (element)
  (let* ((component (if (eq element 'gpu:c32) 'single-float 'double-float))
         (values (map 'vector (lambda (x) (complex (coerce (realpart x) component)
                                                  (coerce (imagpart x) component)))
                      #(#c(1 2) #c(3 -4) #c(-2 1) #c(5 3))))
         (tolerance (if (eq element 'gpu:c32) 3d-6 3d-14)))
    (gpu:with-gpu-array (data (gpu:to-device values))
      (is (eq element (gpu:type-spec (gpu:gpu-array-element-type data))))
      (is (equalp values (gpu:from-device data)))
      (let* ((window (gpu:make-gpu-array-view data 4))
             (a (gpu:make-strided-view window '(2 2) :strides '(2 -1) :offset 1))
             (b (gpu:make-strided-view data '(1 2)))
             (av (vector (aref values 1) (aref values 0) (aref values 3) (aref values 2)))
             (bv (vector (aref values 0) (aref values 1) (aref values 0) (aref values 1))))
        (dolist (pair (list (list #'ew:add #'+) (list #'ew:subtract #'-) (list #'ew:multiply #'*) (list #'ew:divide #'/)))
          (with-result (out (funcall (first pair) a b))
            (is (close-p (map 'vector (second pair) av bv) (gpu:from-device (gpu:strided-view-data out)) tolerance))))
        (dolist (pair (list (list #'ew:negate #'-) (list #'ew:conjugate #'conjugate)
                           (list #'ew:realpart #'realpart) (list #'ew:imagpart #'imagpart) (list #'ew:abs #'abs)))
          (with-result (out (funcall (first pair) a))
            (is (close-p (map 'vector (second pair) av) (gpu:from-device (gpu:strided-view-data out)) tolerance))))
        (with-result (mask (ew:compare :eq a #c(1 2)))
          (is (equalp #(0 1 0 0) (gpu:from-device (gpu:strided-view-data mask))))
          (with-result (out (ew:select mask a #c(9 8)))
            (is (equalp #(#c(9 8) #c(1 2) #c(9 8) #c(9 8)) (gpu:from-device (gpu:strided-view-data out))))))
        (signals gpu:gpu-error (ew:convert a 'gpu:f32))
        (is (eq a (ew:add! a a #c(1 0))))
        (is (equalp (map 'vector (lambda (x) (+ x 1)) values) (gpu:from-device data)))))
    (dolist (real (remove 'gpu:f64 ew::*elements*))
      (gpu:with-gpu-array (data (gpu:to-device #(0 1 2) :element-type real))
        (with-result (z (ew:convert (gpu:make-strided-view data '(3)) element))
          (with-result (back (ew:convert z real))
            (is (equalp #(0 1 2) (gpu:from-device (gpu:strided-view-data back))))))))
    (let* ((bits (if (eq element 'gpu:c32) 32 64))
           (sign (ash 1 (1- bits)))
           (raw (make-array 8 :element-type `(unsigned-byte ,bits)
                             :initial-contents (list 0 sign sign 0 1 (1+ sign)
                                                     (if (= bits 32) #x7fc12345 #x7ff8123456789abc) sign))))
      (gpu:with-gpu-array (data (gpu:to-device raw :element-type element :raw t))
        (is (equalp raw (gpu:from-device data :raw t)))
        (let ((view (gpu:make-strided-view data '(4))))
          (with-result (out (ew:convert view element))
            (is (equalp raw (gpu:from-device (gpu:strided-view-data out) :raw t))))
          (with-result (out (ew:conjugate view))
            (let ((expected (copy-seq raw)))
              (loop for i from 1 below 8 by 2 do (setf (aref expected i) (logxor sign (aref expected i))))
              (is (equalp expected (gpu:from-device (gpu:strided-view-data out) :raw t))))))))
    (gpu:with-gpu-array (data (gpu:to-device #(0 1 2 3) :element-type element))
      (let ((scalar (gpu:make-strided-view data '() :offset 2))
            (empty (gpu:make-strided-view data '(0 3) :offset 4))
            (broadcast (gpu:make-strided-view data '(2 3) :strides '(0 0) :offset 1)))
        (with-result (out (ew:add scalar #c(1 2)))
          (is (equalp #(#c(3 2)) (gpu:from-device (gpu:strided-view-data out)))))
        (with-result (out (ew:add empty 1))
          (is (equalp #(0 3) (gpu:strided-view-shape out))))
        (with-result (out (ew:add broadcast 1))
          (is (equalp #(2 2 2 2 2 2) (gpu:from-device (gpu:strided-view-data out)))))
        (signals gpu:gpu-error (ew:add! broadcast broadcast 1))
        (signals gpu:gpu-error (ew:compare :gt empty 0))
        (signals gpu:gpu-error (ew:convert empty 'gpu:bool))
        (with-result (out (ew:convert (gpu:make-strided-view data '(4)) 'gpu:i8))
          (is (equalp #(0 1 2 3) (gpu:from-device (gpu:strided-view-data out)))))))
    (let* ((bits (if (eq element 'gpu:c32) 32 64))
           (raw (make-array 4 :element-type `(unsigned-byte ,bits)
                             :initial-contents (if (= bits 32) '(#x7fc12345 #x80000000 0 #x7fc54321)
                                                   '(#x7ff8123456789abc #x8000000000000000 0 #x7ff8abcdef123456)))))
      (gpu:with-gpu-array (data (gpu:to-device raw :element-type element :raw t))
        (gpu:with-gpu-array (mask (gpu:to-device #(2 255) :element-type 'gpu:u8))
          (let ((view (gpu:make-strided-view data '(2))))
            (with-result (out (ew:select (gpu:make-strided-view mask '(2)) view 0))
              (is (equalp raw (gpu:from-device (gpu:strided-view-data out) :raw t))))
            (with-result (out (ew:realpart view))
              (let ((actual (make-array 2 :element-type `(unsigned-byte ,bits)))
                    (array (gpu:strided-view-data out)))
                (gpu:device-load (gpu:gpu-array-device array) (gpu::live-buffer array) actual
                                 (gpu:parse-type (if (= bits 32) 'gpu:u32 'gpu:u64)) 0)
                (is (equalp (vector (aref raw 0) (aref raw 2)) actual))))))))
    (let* ((large (if (eq element 'gpu:c32) 1f30 1d250))
           (small (if (eq element 'gpu:c32) 1f-30 1d-250)))
      (gpu:with-gpu-array (data (gpu:to-device (vector (complex large large) (complex small small)) :element-type element))
        (let ((view (gpu:make-strided-view data '(2))))
          (with-result (out (ew:divide view view))
            (is (close-p #(#c(1f0 0f0) #c(1f0 0f0)) (gpu:from-device (gpu:strided-view-data out)) tolerance)))
          (with-result (out (ew:abs view))
            (is (close-p (vector (* (sqrt 2d0) large) (* (sqrt 2d0) small))
                         (gpu:from-device (gpu:strided-view-data out)) tolerance))))))))

(in-suite :cl-gpu/elementwise)
(defclass complex-failure-device (f64-device)
  ((stage :initarg :stage :accessor failure-stage)))
(defmethod gpu:device-allocate :before ((device complex-failure-device) bytes)
  (declare (ignore bytes))
  (when (eq (failure-stage device) :allocate) (gpu::gpu-fail "injected allocation failure")))
(defmethod gpu:device-store :before ((device complex-failure-device) buffer sequence type offset)
  (declare (ignore buffer sequence type offset))
  (when (eq (failure-stage device) :upload) (gpu::gpu-fail "injected upload failure")))
(defmethod gpu:device-prepare :before ((device complex-failure-device) source entry &key precise-math)
  (declare (ignore source entry precise-math))
  (when (eq (failure-stage device) :compile) (gpu::gpu-fail "injected compilation failure")))
(defmethod gpu:device-launch :before ((device complex-failure-device) prepared arguments grid group)
  (declare (ignore prepared arguments grid group))
  (when (eq (failure-stage device) :launch) (gpu::gpu-fail "injected launch failure")))
(defmethod gpu:device-load ((device complex-failure-device) buffer sequence type offset)
  (declare (ignore buffer type offset))
  (when (eq (failure-stage device) :status) (gpu::gpu-fail "injected status failure"))
  (fill sequence 0))

(test complex-failure-cleanup
  (dolist (element '(gpu:c32 gpu:c64))
    (dolist (stage '(:allocate :upload :compile :launch :status))
      (let ((device (make-instance 'complex-failure-device :stage nil)))
        (gpu:with-gpu-array (data (gpu:make-gpu-array 3 :element-type element :device device))
          (let ((view (gpu:make-strided-view data '(3))))
            (setf (failure-stage device) stage)
            (signals gpu:gpu-error (ew:convert view 'gpu:i32))
            (is (= 1 (allocations device)))
            (unless (eq stage :status)
              (signals gpu:gpu-error (ew:add! view view 1))
              (is (= 1 (allocations device))))))
        (is (zerop (allocations device)))))))

(defun complex-transfer-checks (element)
  (gpu:with-gpu-array (data (gpu:to-device #(#c(1 2) #c(3 4) #c(5 6)) :element-type element))
    (let* ((window (gpu:make-gpu-array-view data 2 :offset 1))
           (nested (gpu:make-gpu-array-view window 1 :offset 1)))
      (is (equalp #(#c(3 4) #c(5 6)) (gpu:from-device window)))
      (gpu:copy-into nested #(7 8) :flat t)
      (is (equalp #(1 2 3 4 7 8) (gpu:from-device data :flat t)))
      (let ((into (make-array 1)))
        (is (eq into (gpu:from-device nested :into into)))
        (is (equalp #(#c(7 8)) into))))
    (signals gpu:gpu-error (gpu:copy-into data #(1 2 3) :flat t))
    (signals gpu:gpu-error (gpu:copy-into data #(1 2) :raw t)))
  (signals gpu:gpu-error (gpu:to-device #(1 2 3) :element-type element :flat t))
  (let* ((component (if (eq element 'gpu:c32) 'single-float 'double-float))
         (empty (make-array 0 :element-type `(complex ,component))))
    (gpu:with-gpu-array (data (gpu:to-device empty))
      (is (eq element (gpu:type-spec (gpu:gpu-array-element-type data)))))))

(defun complex-exception-checks (element)
  (let* ((bits (if (eq element 'gpu:c32) 32 64))
         (sign (ash 1 (1- bits)))
         (inf (if (= bits 32) #x7f800000 #x7ff0000000000000))
         (nan (logior inf (ash 1 (if (= bits 32) 22 51))))
         (raw (make-array 6 :element-type `(unsigned-byte ,bits)
                           :initial-contents (list 0 sign inf nan nan 0))))
    (gpu:with-gpu-array (data (gpu:to-device raw :element-type element :raw t))
      (let ((view (gpu:make-strided-view data '(3))))
        (with-result (out (ew:abs view))
          (let ((actual (make-array 3 :element-type `(unsigned-byte ,bits)))
                (array (gpu:strided-view-data out)))
            (gpu:device-load (gpu:gpu-array-device array) (gpu::live-buffer array) actual
                             (gpu:parse-type (if (= bits 32) 'gpu:u32 'gpu:u64)) 0)
            (is (= 0 (aref actual 0)))
            (is (= inf (aref actual 1)))
            (is (not (zerop (logand (aref actual 2) (1- (ash 1 (if (= bits 32) 23 52)))))))))
        (with-result (out (ew:compare :eq view view))
          (is (equalp #(1 0 0) (gpu:from-device (gpu:strided-view-data out)))))
        (with-result (out (ew:compare :ne view view))
          (is (equalp #(0 1 1) (gpu:from-device (gpu:strided-view-data out)))))
        (signals gpu:gpu-error (ew:convert view 'gpu:f32)))))
  (let ((tiny (if (eq element 'gpu:c32) 1f-30 1d-250)))
    (gpu:with-gpu-array (data (gpu:to-device (vector (complex tiny tiny)) :element-type element))
      (with-result (out (ew:divide 0 (gpu:make-strided-view data '(1))))
        (is (equalp #(0) (gpu:from-device (gpu:strided-view-data out))))))))
