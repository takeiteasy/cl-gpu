(in-package #:cl-gpu/expressions/tests)
(in-suite :cl-gpu/expressions/metal)

(defun coordinates (shape function)
  (let ((index (make-array (length shape) :initial-element 0)))
    (labels ((visit (axis)
               (if (= axis (length shape)) (funcall function index)
                   (dotimes (i (elt shape axis))
                     (setf (aref index axis) i) (visit (1+ axis))))))
      (visit 0))))

(defun values-of (view)
  (let ((storage (gpu:from-device (gpu:strided-view-data view))) (result nil))
    (coordinates (gpu:strided-view-shape view)
                 (lambda (index)
                   (push (aref storage (+ (gpu:strided-view-offset view)
                                          (loop for i across index for s across (gpu:strided-view-strides view) sum (* i s))))
                         result)))
    (coerce (nreverse result) 'vector)))

(defun close-p (expected actual &optional (tolerance 1d-4))
  (and (= (length expected) (length actual))
       (every (lambda (a b) (<= (abs (- a b)) (* tolerance (max 1d0 (abs a) (abs b))))) expected actual)))

(defun reference (body names operands shape axes)
  (let ((storages (mapcar (lambda (x) (when (gpu:strided-view-p x) (gpu:from-device (gpu:strided-view-data x)))) operands))
        (answer nil))
    (labels ((leaf (name index)
               (let* ((p (position name names)) (input (nth p operands)))
                 (if (gpu:strided-view-p input)
                     (let* ((dims (gpu:strided-view-shape input)) (rank (length dims))
                            (offset (+ (gpu:strided-view-offset input)
                                       (loop for a below rank
                                             sum (* (if (= (aref dims a) 1) 0 (aref index (+ (- (length shape) rank) a)))
                                                    (aref (gpu:strided-view-strides input) a))))))
                       (float (aref (nth p storages) offset) 1d0))
                     (float input 1d0))))
             (walk (node index)
               (cond
                 ((realp node) (float node 1d0))
                 ((symbolp node) (leaf node index))
                 ((member (car node) '(:sum :prod :minimum :maximum :argmin :argmax))
                  (let ((values nil) (at (copy-seq index)))
                    (coordinates (map 'vector (lambda (a) (aref shape a)) axes)
                                 (lambda (reduced)
                                   (loop for a in axes for i across reduced do (setf (aref at a) i))
                                   (push (walk (second node) at) values)))
                    (setf values (nreverse values))
                    (case (car node)
                      (:sum (reduce #'+ values :initial-value 0d0))
                      (:prod (reduce #'* values :initial-value 1d0))
                      (:minimum (reduce #'min values)) (:maximum (reduce #'max values))
                      (:argmin (position (reduce #'min values) values))
                      (:argmax (position (reduce #'max values) values)))))
                 ((eq (car node) :select) (if (walk (second node) index) (walk (third node) index) (walk (fourth node) index)))
                 (t (let ((args (mapcar (lambda (n) (walk n index)) (cdr node))))
                      (apply (ecase (car node)
                               (:add #'+) (:subtract #'-) (:multiply #'*) (:divide #'/)
                               (:abs #'abs) (:sqrt #'sqrt) (:min #'min) (:max #'max)
                               (:exp #'exp) (:sin #'sin) (:cos #'cos) (:log #'log) (:tanh #'tanh)
                               (:sigmoid (lambda (x) (/ 1d0 (+ 1d0 (exp (- x))))))
                               (:fma (lambda (a b c) (+ (* a b) c)))
                               (:eq #'=) (:ne #'/=) (:lt #'<) (:le #'<=) (:gt #'>) (:ge #'>=)) args))))))
      (let* ((outer (and (consp body) (member (car body) '(:sum :prod :minimum :maximum :argmin :argmax))))
             (output (if outer (map 'vector (lambda (a) (if (member a axes) 1 (aref shape a)))
                                     (coerce (loop for a below (length shape) collect a) 'vector)) shape)))
        (coordinates output (lambda (index) (push (walk body index) answer)))))
    (coerce (nreverse answer) 'vector)))

(test metal-arithmetic-and-storage-types
  (dolist (element '(gpu:f32 gpu:f16 gpu:bf16))
    (gpu:with-gpu-array (data (gpu:to-device #(0.25f0 0.5f0 1f0 2f0) :element-type element))
      (let ((a (gpu:make-strided-view data '(4))))
        (dolist (body '((:add (:multiply a b) 1) (:subtract a b 1) (:divide a b 2)
                        (:subtract a) (:divide a) (:abs (:subtract a 1))
                        (:sqrt a) (:min a b 1) (:max a b 1) (:exp a) (:sin a) (:cos a)
                        (:log a) (:tanh a) (:sigmoid a) (:fma a b 1)
                        (:select (:le a 1) a b) (:select (:ge a 1) a b)
                        (:select (:eq a 1) a b) (:select (:ne a 1) a b)))
          (with-result (out (ex:execute-expression (ex:make-expression-plan '(a b) body) (list a 2)))
            (is (close-p (reference body '(a b) (list a 2) #(4) nil) (values-of out)
                         (if (eq element 'gpu:f32) 1d-5 1d-2)))))))))

(test metal-layouts-reductions-and-selection
  (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0 4f0 5f0 6f0 7f0 8f0 9f0 10f0 11f0 12f0)))
    (let ((window (gpu:make-gpu-array-view data 8 :offset 2)))
      (dolist (a (list (gpu:make-strided-view data '(2 3))
                       (gpu:make-strided-view data '(2 3) :strides '(1 2))
                       (gpu:make-strided-view data '(2 3) :strides '(3 -1) :offset 2)
                       (gpu:make-strided-view window '(2 3) :strides '(-3 1) :offset 3)
                       (gpu:make-strided-view data '(2 3) :strides '(0 1))))
        (let ((b (gpu:make-strided-view data '(2 1) :offset 6)))
          (dolist (axes '((0) (1) (0 1) ()))
            (dolist (body '((:add (:multiply a b) 1) (:sum (:multiply a b)) (:prod a)
                            (:minimum a) (:maximum a) (:argmin a) (:argmax a)
                            (:divide a (:sum a)) (:add a (:argmax a))
                            (:sum (:add a (:prod a)))
                            (:divide (:exp (:subtract a (:maximum a)))
                                     (:sum (:exp (:subtract a (:maximum a)))))
                            (:select (:gt a 2) (:sum a) (:maximum a))
                            (:add (:select (:lt a 3) (:sum a) 0)
                                  (:select (:gt a 2) (:sum a) 0))
                            (:select (:gt (:sum a) 2) (:argmin a) (:argmax a))
                            (:sum (:select (:gt (:sum a) 2) (:sum a) a))
                            (:sum (:select (:lt a 3) a (:sum (:multiply a b))))))
              (with-result (out (ex:execute-expression (ex:make-expression-plan '(a b) body)
                                                      (list a b) :axis (coerce axes 'vector)))
                (is (close-p (reference body '(a b) (list a b) #(2 3) axes) (values-of out) 2d-4))))))))))

(test metal-lazy-math-and-conditional-groups
  (gpu:with-gpu-array (data (gpu:to-device #(1f0 4f0 -1f0 -4f0)))
    (let ((a (gpu:make-strided-view data '(2 2))))
      (dolist (body '((:select (:gt a 0) (:sqrt a) 0)
                      (:sum (:select (:gt a 0) (:sqrt a) 0))
                      (:select (:gt a 0) (:sum (:sqrt a)) 7)
                      (:select (:gt a 0) (:sum (:select (:gt a 0) (:sqrt a) 0)) 7)
                      (:select (:lt (:sum a) 0) 5 (:sum (:sqrt a)))
                      (:select (:gt a 0) (:sum (:log a)) 3)))
        (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) body) (list a) :axis -1))
          (is (close-p (reference body '(a) (list a) #(2 2) '(1)) (values-of out)))))
      (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) '(:sqrt a)) (list a)))
        (let ((values (gpu:from-device (gpu:strided-view-data out))))
          (is (float-features:float-nan-p (aref values 2))))))))

(test metal-staged-aliases-padding-and-validation
  (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0 4f0 5f0 6f0 99f0 99f0)))
    (let* ((plan (ex:make-expression-plan '(a) '(:add a (:sum a))))
           (input (gpu:make-strided-view data '(2 3)))
           (out (gpu:make-strided-view data '(2 3) :strides '(1 2) :offset 1))
           (expected (reference '(:add a (:sum a)) '(a) (list input) #(2 3) '(1))))
      (is (eq out (ex:execute-expression! out plan (list input) :axis -1)))
      (is (equalp expected (values-of out)))
      (let ((values (gpu:from-device data))) (is (= 1f0 (aref values 0))) (is (= 99f0 (aref values 7))))
      (let ((snapshot (gpu:from-device data :raw t)))
        (signals gpu:gpu-error (ex:execute-expression! out plan (list input) :axis 9))
        (signals gpu:gpu-error (ex:execute-expression! (gpu:make-strided-view data '(2 3) :strides '(0 1)) plan (list input)))
        (is (equalp snapshot (gpu:from-device data :raw t)))))))

(test metal-empty-scalar-and-arg-ties
  (gpu:with-gpu-array (data (gpu:to-device #(4f0 1f0 1f0 4f0)))
    (dolist (spec '((:sum 0f0) (:prod 1f0)))
      (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) (list (first spec) '(:maximum a)))
                                              (list (gpu:make-strided-view data '(2 0))) :axis -1 :keepdims t))
        (is (equalp #(2 1) (gpu:strided-view-shape out)))
        (is (equalp (vector (second spec) (second spec)) (values-of out)))))
    (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) '(:sum a))
                                            (list (gpu:make-strided-view data '(0 2))) :axis -1))
      (is (equalp #(0) (gpu:strided-view-shape out))))
    (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) '(:multiply a 2))
                                            (list (gpu:make-strided-view data '#()))))
      (is (equalp #() (gpu:strided-view-shape out))) (is (equalp #(8f0) (values-of out))))
    (dolist (spec '((:argmin 1) (:argmax 0)))
      (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) (list (first spec) 'a))
                                              (list (gpu:make-strided-view data '(4)))))
        (is (= (second spec) (aref (values-of out) 0)))))))

(test metal-separate-rounding-and-fma
  (gpu:with-gpu-array (data (gpu:to-device (vector (+ 1f0 (expt 2f0 -23)) (- 1f0 (expt 2f0 -23)))))
    (let ((operands (list (gpu:make-strided-view data '(1)) (gpu:make-strided-view data '(1) :offset 1))))
      (with-result (plain (ex:execute-expression (ex:make-expression-plan '(a b) '(:add (:multiply a b) -1)) operands))
        (is (zerop (aref (values-of plain) 0))))
      (with-result (fused (ex:execute-expression (ex:make-expression-plan '(a b) '(:fma a b -1)) operands))
        (is (= (- (expt 2f0 -46)) (aref (values-of fused) 0)))))))

(test metal-concurrent-plan-reuse
  (let* ((device (gpu:current-device))
         (plan (ex:make-expression-plan '(a b) '(:add a (:sum (:multiply a b)))))
         (failures nil) (lock (bt:make-lock "expression test results")))
    (let ((threads
            (loop for worker below 4 collect
              (bt:make-thread
               (lambda ()
                 (handler-case
                     (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0) :device device))
                       (dotimes (i 3)
                         (with-result (out (ex:execute-expression plan (list (gpu:make-strided-view data '(3)) 2)))
                           (unless (equalp #(13f0 14f0 15f0) (values-of out)) (error "concurrent result mismatch")))))
                   (error (e) (bt:with-lock-held (lock) (push e failures)))))
               :name "expression caller"))))
      (mapc #'bt:join-thread threads))
    (is (null failures))))

(test metal-low-precision-intermediates
  (dolist (spec '((gpu:f16 2048f0) (gpu:bf16 256f0)))
    (gpu:with-gpu-array (data (gpu:to-device (vector (second spec) (second spec)) :element-type (first spec)))
      (dolist (body '((:subtract (:add a 1) a) (:sum (:subtract (:add a 1) a))))
        (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) body)
                                                (list (gpu:make-strided-view data '(2)))))
          (is (equalp (if (eq (first body) :sum) #(2f0) #(1f0 1f0)) (values-of out))))))))

(test metal-long-groups-and-logical-indices
  (let ((host (make-array 1200 :element-type 'single-float :initial-element 3f0)))
    (setf (aref host 257) -1f0 (aref host 513) -1f0)
    (gpu:with-gpu-array (data (gpu:to-device host))
      (let ((input (gpu:make-strided-view data '(2 3 200) :strides '(600 1 3))))
        (dolist (axes '((2 0) (0 2) (0 1 2)))
          (dolist (op '(:sum :prod :minimum :maximum :argmin :argmax))
            (let ((body (list op (if (eq op :prod) '(:divide a 3) 'a))))
              (with-result (out (ex:execute-expression (ex:make-expression-plan '(a) body) (list input) :axis axes))
                (is (close-p (reference body '(a) (list input) #(2 3 200) (sort (copy-list axes) #'<))
                             (values-of out)))))))))))

(defclass fault-device (mock-device) ((backend :initarg :backend :reader backend)))
(defmethod gpu:device-allocate ((device fault-device) bytes)
  (when (eq (fail-at device) :allocate) (error 'gpu:gpu-error :message "injected allocation failure"))
  (let ((buffer (gpu:device-allocate (backend device) bytes))) (incf (allocations device)) buffer))
(defmethod gpu:device-free ((device fault-device) buffer)
  (gpu:device-free (backend device) buffer) (decf (allocations device)))
(defmethod gpu:device-store ((device fault-device) buffer sequence type offset)
  (call-next-method) (gpu:device-store (backend device) buffer sequence type offset))
(defmethod gpu:device-load ((device fault-device) buffer sequence type offset)
  (gpu:device-load (backend device) buffer sequence type offset))
(defmethod gpu:device-prepare ((device fault-device) source entry &key precise-math)
  (call-next-method) (gpu:device-prepare (backend device) source entry :precise-math precise-math))
(defmethod gpu:device-launch ((device fault-device) prepared arguments grid group)
  (call-next-method) (gpu:device-launch (backend device) prepared arguments grid group))
(defmethod gpu:device-synchronize ((device fault-device))
  (gpu:device-synchronize (backend device))
  (call-next-method)
  (when (and (eq (fail-at device) :commit-wait) (= (waits device) 2))
    (error 'gpu:gpu-error :message "injected final-copy completion failure")))

(test metal-computation-failures-preserve-destinations
  (dolist (failure '(:allocate :upload :prepare :launch :wait 2))
    (let ((device (make-instance 'fault-device :backend (gpu:current-device))))
      (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0 4f0 5f0 6f0) :device device))
        (let* ((input (gpu:make-strided-view data '(2 3)))
               (snapshot (gpu:from-device data))
               (plan (ex:make-expression-plan '(a) '(:add a (:sum a)))))
          (setf (fail-at device) failure)
          (signals gpu:gpu-error (ex:execute-expression! input plan (list input) :axis -1))
          (setf (fail-at device) nil)
          (is (equalp snapshot (gpu:from-device data)))
          (is (= 1 (allocations device)))
          (is (eq input (ex:execute-expression! input plan (list input) :axis -1)))
          (is (equalp #(7f0 8f0 9f0 19f0 20f0 21f0) (values-of input)))))
      (is (zerop (allocations device))))))

(test metal-final-copy-failure-boundary
  (let ((device (make-instance 'fault-device :backend (gpu:current-device))))
    (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0) :device device))
      (let ((out (gpu:make-strided-view data '(3)))
            (plan (ex:make-expression-plan '(a) '(:add a 1))))
        (setf (fail-at device) :commit-wait)
        (signals gpu:gpu-error (ex:execute-expression! out plan (list out)))
        (setf (fail-at device) nil)
        (is (equalp #(2f0 3f0 4f0) (values-of out)))
        (is (= 1 (allocations device)))))
    (is (zerop (allocations device)))))
