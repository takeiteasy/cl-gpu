(in-package #:cl-gpu/gather/tests)
(in-suite :cl-gpu/gather/metal)

(defun coordinates (shape function)
  (let ((position (make-array (length shape))))
    (labels ((visit (axis)
               (if (= axis (length shape)) (funcall function position)
                   (dotimes (i (elt shape axis))
                     (setf (aref position axis) i)
                     (visit (1+ axis))))))
      (visit 0))))

(defun host-address (view coordinates)
  (+ (gpu:strided-view-offset view)
     (loop for coordinate across coordinates for stride across (gpu:strided-view-strides view)
           sum (* coordinate stride))))

(defun logical-values (view &key raw)
  (let ((data (gpu:from-device (gpu:strided-view-data view) :raw raw)) (values nil))
    (coordinates (gpu:strided-view-shape view)
                 (lambda (coordinate) (push (aref data (host-address view coordinate)) values)))
    (coerce (nreverse values) 'vector)))

(defun reference-gather (input indices axis &key raw)
  (let* ((shape (gpu:strided-view-shape input))
         (axis (mod axis (length shape)))
         (index-shape (gpu:strided-view-shape indices))
         (result-shape (concatenate 'vector (subseq shape 0 axis) index-shape (subseq shape (1+ axis))))
         (source (gpu:from-device (gpu:strided-view-data input) :raw raw))
         (ids (gpu:from-device (gpu:strided-view-data indices)))
         (values nil))
    (coordinates
     result-shape
     (lambda (coordinate)
       (let* ((index-end (+ axis (length index-shape)))
              (id (aref ids (host-address indices (subseq coordinate axis index-end))))
              (selected (if (minusp id) (+ id (aref shape axis)) id))
              (source-coordinate (concatenate 'vector (subseq coordinate 0 axis)
                                              (vector selected) (subseq coordinate index-end))))
         (push (aref source (host-address input source-coordinate)) values))))
    (values result-shape (coerce (nreverse values) 'vector))))

(test all-storage-and-index-formats
  (dolist (element g::*elements*)
    (gpu:with-gpu-array (data (gpu:to-device #(1 2 3 4 5 6) :element-type element))
      (let ((input (gpu:make-strided-view data '(2 3))))
        (dolist (index-element g::*index-elements*)
          (gpu:with-gpu-array (ids (gpu:to-device #(1 0 1 0) :element-type index-element))
            (let ((indices (gpu:make-strided-view ids '(2 2))))
              (multiple-value-bind (shape expected) (reference-gather input indices 0)
                (with-result (out (g:gather input indices))
                  (is (equalp shape (gpu:strided-view-shape out)))
                  (is (equalp expected (logical-values out))))))))))))

(test axes-scalar-and-batched-indices
  (gpu:with-gpu-array (data (gpu:to-device (map 'vector #'float (loop for i below 24 collect i))))
    (let ((input (gpu:make-strided-view data '(2 3 4))))
      (dolist (axis '(0 1 2 -1 -2 -3))
        (gpu:with-gpu-array (ids (gpu:to-device #(0 -1 0 -1) :element-type 'gpu:i64))
          (dolist (index-shape '(() (4) (2 2)))
            (let ((indices (gpu:make-strided-view ids index-shape)))
              (multiple-value-bind (shape expected) (reference-gather input indices axis)
                (with-result (out (g:gather input indices :axis axis))
                  (is (equalp shape (gpu:strided-view-shape out)))
                  (is (equalp expected (logical-values out))))))))))))

(test bounds-and-empty-results
  (gpu:with-gpu-array (data (gpu:to-device #(11f0 12f0 13f0 14f0 99f0 99f0)))
    (let ((input (gpu:make-strided-view data '(2 2)))
          (out (gpu:make-strided-view data '(1 2) :offset 4)))
      (dolist (element g::*index-elements*)
        (let* ((type (gpu:parse-type element))
               (signed (gpu::signed-type-p type))
               (bits (gpu:scalar-type-bits type)))
          (dolist (value (if signed (list -3 2 (- (expt 2 (1- bits))) (1- (expt 2 (1- bits))))
                             (list 2 (1- (expt 2 bits)))))
            (gpu:with-gpu-array (ids (gpu:to-device (vector value) :element-type element))
              (let ((indices (gpu:make-strided-view ids '(1)))
                    (before (gpu:from-device data)))
                (signals gpu:gpu-error (g:gather! out input indices))
                (is (equalp before (gpu:from-device data)))
                (signals gpu:gpu-error (g:gather (gpu:make-strided-view data '(2 0)) indices))
                (signals gpu:gpu-error (g:gather (gpu:make-strided-view data '(0 2)) indices)))))))
      (gpu:with-gpu-array (ids (gpu:to-device #(0) :element-type 'gpu:i8))
        (with-result (result (g:gather (gpu:make-strided-view data '(2 0)) (gpu:make-strided-view ids '())))
          (is (equalp #(0) (gpu:strided-view-shape result))))
        (signals gpu:gpu-error (g:gather (gpu:make-strided-view data '(0 2)) (gpu:make-strided-view ids '()))))
      (gpu:with-gpu-array (ids (gpu:make-gpu-array 0 :element-type 'gpu:u8))
        (with-result (result (g:gather (gpu:make-strided-view data '(0 2)) (gpu:make-strided-view ids '(2 0))))
          (is (equalp #(2 0 2) (gpu:strided-view-shape result))))))))

(test input-and-index-aliases
  (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0 4f0 5f0 6f0)))
    (gpu:with-gpu-array (ids (gpu:to-device #(2 0 1) :element-type 'gpu:u8))
      (let ((input (gpu:make-strided-view data '(2 3))))
        (is (eq input (g:gather! input input (gpu:make-strided-view ids '(3)) :axis 1)))
        (is (equalp #(3f0 1f0 2f0 6f0 4f0 5f0) (gpu:from-device data))))))
  (gpu:with-gpu-array (data (gpu:to-device #(10 20 30) :element-type 'gpu:i64))
    (gpu:with-gpu-array (ids (gpu:to-device #(2 0 1 99 99) :element-type 'gpu:i64))
      (let ((indices (gpu:make-strided-view ids '(3))))
        (is (eq indices (g:gather! indices (gpu:make-strided-view data '(3)) indices)))
        (is (equalp #(30 10 20 99 99) (gpu:from-device ids))))))
  (gpu:with-gpu-array (data (gpu:to-device #(2 0 1) :element-type 'gpu:i32))
    (let ((view (gpu:make-strided-view data '(3))))
      (g:gather! view view view)
      (is (equalp #(1 2 0) (gpu:from-device data))))))

(defun make-window-layout (shape strides &key (element 'gpu:f32) (value #'identity))
  (let* ((low (loop for d across shape for s across strides sum (min 0 (* (1- d) s))))
         (high (loop for d across shape for s across strides sum (max 0 (* (1- d) s))))
         (span (1+ (- high low)))
         (data (gpu:to-device (map 'vector value (loop for i below (+ span 11) collect i)) :element-type element)))
    (gpu:make-strided-view (gpu:make-gpu-array-view data (+ span 5) :offset 3)
                           shape :strides strides :offset (- 2 low))))

(defmacro with-layout ((name form) &body body)
  `(let ((,name ,form))
     (unwind-protect (progn ,@body) (gpu:free (gpu::view-root ,name)))))

(test seeded-strided-window-reference-and-guards
  (let ((seed 80))
    (labels ((pick (limit)
               (mod (setf seed (mod (+ (* seed 1664525) 1013904223) (expt 2 32))) limit))
             (layout (shape broadcastp)
               (let* ((rank (length shape)) (rotation (pick rank))
                      (strides (make-array rank)) (step 1))
                 (dotimes (i rank strides)
                   (let ((axis (mod (+ i rotation) rank)))
                     (setf (aref strides axis) (if (and broadcastp (zerop (pick 4))) 0
                                                   (* step (if (zerop (pick 2)) -1 1))))
                     (setf step (* step (1+ (aref shape axis)))))))))
      (dotimes (trial 32)
        (let* ((shape (map 'vector (lambda (x) (declare (ignore x)) (1+ (pick 4))) #(0 0 0)))
               (axis (pick 3)) (extent (aref shape axis)))
          (with-layout (input (make-window-layout shape (layout shape t)))
            (with-layout (indices (make-window-layout #(2 3) (layout #(2 3) t) :element 'gpu:i64
                                                      :value (lambda (i) (- (mod i (* 2 extent)) extent))))
              (multiple-value-bind (result-shape expected) (reference-gather input indices axis)
                (with-result (result (g:gather input indices :axis axis))
                  (is (equalp expected (logical-values result))))
                (with-layout (out (make-window-layout result-shape (layout result-shape nil)
                                                      :value (constantly -99f0)))
                  (let* ((root (gpu::view-root out)) (before (gpu:from-device root))
                         (touched (make-hash-table)))
                    (coordinates result-shape (lambda (coordinate)
                                                (setf (gethash (+ 3 (host-address out coordinate)) touched) t)))
                    (is (eq out (g:gather! out input indices :axis axis)))
                    (is (equalp expected (logical-values out)))
                    (let ((after (gpu:from-device root)))
                      (is (loop for i below (length before)
                                always (or (gethash i touched) (= (aref before i) (aref after i))))))))))))))))

(test every-half-encoding-copies-without-conversion
  (let ((bits (make-array 65536 :element-type '(unsigned-byte 16)))
        (order (make-array 65536 :element-type '(unsigned-byte 32))))
    (dotimes (i 65536) (setf (aref bits i) i (aref order i) (- 65535 i)))
    (dolist (element '(gpu:f16 gpu:bf16))
      (gpu:with-gpu-array (data (gpu:to-device bits :element-type element :raw t))
        (gpu:with-gpu-array (ids (gpu:to-device order :element-type 'gpu:u32 :raw t))
          (let ((input (gpu:make-strided-view data '(65536))) (indices (gpu:make-strided-view ids '(65536))))
            (with-result (out (g:gather input indices))
              (is (equalp (reverse bits) (logical-values out :raw t))))
            (g:gather! input input indices)
            (is (equalp (reverse bits) (gpu:from-device data :raw t)))))))))

(test f32-special-bits-and-integer-extremes
  (gpu:with-gpu-array (data (gpu:make-gpu-array 6))
    (let ((bits (make-array 6 :element-type '(unsigned-byte 32)
                            :initial-contents '(#x80000000 #x7f800001 #x7fc01234 #xff800000 #x00000001 #x3f800000))))
      (gpu:device-store (gpu:gpu-array-device data) (gpu::array-buffer data) bits (gpu:parse-type 'gpu:u32) 0)
      (gpu:with-gpu-array (ids (gpu:to-device #(5 4 3 2 1 0) :element-type 'gpu:u8))
        (let ((input (gpu:make-strided-view data '(6))))
          (g:gather! input input (gpu:make-strided-view ids '(6)))
          (let ((actual (copy-seq bits)))
            (gpu:device-load (gpu:gpu-array-device data) (gpu::array-buffer data) actual (gpu:parse-type 'gpu:u32) 0)
            (is (equalp (reverse bits) actual)))))))
  (dolist (element g::*index-elements*)
    (let* ((type (gpu:parse-type element)) (bits (gpu:scalar-type-bits type))
           (signed (gpu::signed-type-p type))
           (values (vector (if signed (- (expt 2 (1- bits))) 0)
                           (1- (expt 2 (if signed (1- bits) bits))))))
      (gpu:with-gpu-array (data (gpu:to-device values :element-type element))
        (gpu:with-gpu-array (ids (gpu:to-device #(1 0) :element-type 'gpu:u8))
          (with-result (out (g:gather (gpu:make-strided-view data '(2)) (gpu:make-strided-view ids '(2))))
            (is (equalp (reverse values) (logical-values out)))))))))

(defvar *transfers* nil)
(defvar *record-transfers* nil)
(defvar *injected-failure* nil)
(defvar *submitted-launches* 0)
(defvar *pending-copy-failure* nil)

(defmethod gpu:device-launch :around ((device cl-gpu/metal::metal-device) pipeline arguments grid group)
  (prog1 (call-next-method)
    (when *injected-failure*
      (incf *submitted-launches*)
      (when (eql *injected-failure* *submitted-launches*)
        (gpu::gpu-fail "injected failure after device submission"))
      (when (and (eq *injected-failure* :copy-completion) (= *submitted-launches* 3))
        (setf *pending-copy-failure* t)))))

(defmethod gpu:device-synchronize :around ((device cl-gpu/metal::metal-device))
  (prog1 (call-next-method)
    (when *pending-copy-failure*
      (setf *pending-copy-failure* nil)
      (gpu::gpu-fail "injected final-copy completion failure"))))

(defmethod gpu:device-load :around ((device cl-gpu/metal::metal-device) buffer sequence type offset)
  (when *record-transfers* (push (list :load buffer (length sequence) (gpu:scalar-type-name type)) *transfers*))
  (prog1 (call-next-method)
    (when (and (eq *injected-failure* :completion) (eq (gpu:scalar-type-name type) 'gpu:u32))
      (gpu::gpu-fail "injected gather completion failure"))))
(defmethod gpu:device-store :around ((device cl-gpu/metal::metal-device) buffer sequence type offset)
  (when *record-transfers* (push (list :store buffer (length sequence) (gpu:scalar-type-name type)) *transfers*))
  (call-next-method))

(test only-status-downloads-during-gather
  (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0)))
    (gpu:with-gpu-array (ids (gpu:to-device #(2 0) :element-type 'gpu:u8))
      (let ((input (gpu:make-strided-view data '(3))) (indices (gpu:make-strided-view ids '(2)))
            (*transfers* nil) (*record-transfers* t))
        (with-result (out (g:gather input indices))
          (let ((loads (remove-if-not (lambda (e) (eq (first e) :load)) *transfers*)))
            (is (= 1 (length loads)))
            (is (equal '(1 gpu:u32) (cddr (first loads))))
            (is (not (member (second (first loads)) (list (gpu::array-buffer data) (gpu::array-buffer ids))))))
          (is (every (lambda (e) (or (eq (first e) :load) (eq (fourth e) 'gpu:i64))) *transfers*)))))))

(test submission-and-completion-failures-preserve-destination
  (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0)))
    (gpu:with-gpu-array (ids (gpu:to-device #(2 0 1) :element-type 'gpu:u8))
      (let ((input (gpu:make-strided-view data '(3))) (indices (gpu:make-strided-view ids '(3))))
        (dolist (stage '(1 2 :completion))
          (let ((*injected-failure* stage) (*submitted-launches* 0))
            (signals gpu:gpu-error (g:gather! input input indices)))
          (gpu:synchronize)
          (is (equalp #(1f0 2f0 3f0) (gpu:from-device data))))))))

(test final-copy-failure-has-no-rollback
  (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0)))
    (gpu:with-gpu-array (ids (gpu:to-device #(2 0 1) :element-type 'gpu:u8))
      (let ((input (gpu:make-strided-view data '(3))) (indices (gpu:make-strided-view ids '(3))))
        (let ((*injected-failure* 3) (*submitted-launches* 0))
          (signals gpu:gpu-error (g:gather! input input indices)))
        (gpu:synchronize)
        (is (equalp #(3f0 1f0 2f0) (gpu:from-device data)))))))

(test final-copy-completion-is-reported-by-next-wait
  (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0)))
    (gpu:with-gpu-array (ids (gpu:to-device #(2 0 1) :element-type 'gpu:u8))
      (let ((input (gpu:make-strided-view data '(3))) (indices (gpu:make-strided-view ids '(3)))
            (*injected-failure* :copy-completion) (*submitted-launches* 0) (*pending-copy-failure* nil))
        (is (eq input (g:gather! input input indices)))
        (signals gpu:gpu-error (gpu:synchronize))
        (is (equalp #(3f0 1f0 2f0) (gpu:from-device data)))))))

(test signed-64-bit-axis-extent
  (gpu:with-gpu-array (data (gpu:to-device #(42f0)))
    (let* ((extent (1- (expt 2 63)))
           (input (gpu:make-strided-view data (list extent) :strides '(0))))
      (dolist (element '(gpu:i64 gpu:u64))
        (gpu:with-gpu-array (ids (gpu:to-device (if (eq element 'gpu:i64)
                                                    (vector (- extent) (1- extent))
                                                    (vector 0 (1- extent))) :element-type element))
          (with-result (out (g:gather input (gpu:make-strided-view ids '(2))))
            (is (equalp #(42f0 42f0) (logical-values out))))))
      (gpu:with-gpu-array (ids (gpu:to-device (vector extent) :element-type 'gpu:u64))
        (signals gpu:gpu-error (g:gather input (gpu:make-strided-view ids '(1))))))))

(test irregular-unique-destination-and-overlap-rejection
  (gpu:with-gpu-array (data (gpu:to-device #(1f0 2f0 3f0 4f0 5f0 6f0)))
    (gpu:with-gpu-array (ids (gpu:to-device #(2 0 1) :element-type 'gpu:i8))
      (gpu:with-gpu-array (target (gpu:to-device #(-9f0 -9f0 -9f0 -9f0 -9f0 -9f0 -9f0 -9f0)))
        (let ((input (gpu:make-strided-view data '(3 2))) (indices (gpu:make-strided-view ids '(3)))
              (out (gpu:make-strided-view target '(3 2) :strides '(2 3))))
          (g:gather! out input indices)
          (is (equalp #(5f0 6f0 1f0 2f0 3f0 4f0) (logical-values out)))
          (let ((before (gpu:from-device target)))
            (signals gpu:gpu-error
                     (g:gather! (gpu:make-strided-view target '(3 2) :strides '(1 2)) input indices))
            (is (equalp before (gpu:from-device target)))))))))
