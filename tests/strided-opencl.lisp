(defpackage #:cl-gpu/strided/opencl/tests
  (:use #:cl #:fiveam)
  (:local-nicknames (#:gpu #:cl-gpu) (#:ocl #:cl-gpu/opencl)
                    (#:ew #:cl-gpu/elementwise) (#:red #:cl-gpu/reductions)
                    (#:ref #:cl-gpu/elementwise/tests))
  (:export #:run-elementwise-tests #:run-reduction-tests))
(in-package #:cl-gpu/strided/opencl/tests)

(def-suite :cl-gpu/elementwise/opencl)
(def-suite :cl-gpu/reductions/opencl)

(defun run-suite (suite)
  (let ((gpu:*device* (ocl:default-device)))
    (unless (gpu:device-native-type-p gpu:*device* 'gpu:f64)
      (error "The f64 conformance suites require native OpenCL f64"))
    (run! suite)))

(defun run-elementwise-tests () (run-suite :cl-gpu/elementwise/opencl))
(defun run-reduction-tests () (run-suite :cl-gpu/reductions/opencl))

(defmacro with-result ((name form) &body body)
  `(let ((,name ,form))
     (unwind-protect (progn ,@body) (gpu:free (gpu:strided-view-data ,name)))))

(defun close-values (expected actual)
  (ref::close-p expected actual 2d-13))

(in-suite :cl-gpu/elementwise/opencl)

(test native-capability-and-f64-arithmetic
  (is (gpu:device-native-type-p gpu:*device* 'gpu:f64))
  (is (gpu:device-native-type-p gpu:*device* 'gpu:f32))
  (is (not (gpu:device-native-type-p gpu:*device* 'gpu:bf16)))
  (gpu:with-gpu-array (data (gpu:to-device #(16777217d0 16777219d0 -16777217d0) :element-type 'gpu:f64))
    (let ((input (gpu:make-strided-view data '(3))))
      (dolist (spec (list (list #'ew:add #'+) (list #'ew:subtract #'-) (list #'ew:multiply #'*)
                         (list #'ew:divide #'/) (list #'ew:min #'min) (list #'ew:max #'max)))
        (with-result (out (funcall (first spec) input 1.0000000000000002d0))
          (is (close-values (map 'vector (lambda (x) (funcall (second spec) x 1.0000000000000002d0))
                                 #(16777217d0 16777219d0 -16777217d0)) (ref::values-of out)))))
      (with-result (out (ew:add input 16777217d0))
        (is (equalp #(33554434d0 33554436d0 0d0) (ref::values-of out))))
      (dolist (operator '(:eq :ne :lt :le :gt :ge))
        (with-result (mask (ew:compare operator input 16777218d0))
          (is (equalp (map 'vector (lambda (x) (if (funcall (ecase operator
                                                       (:eq #'=) (:ne #'/=) (:lt #'<) (:le #'<=) (:gt #'>) (:ge #'>=))
                                                     x 16777218d0) 1 0))
                                    #(16777217d0 16777219d0 -16777217d0)) (ref::values-of mask)))
          (with-result (out (ew:select mask input 16777221d0))
            (is (every (lambda (x) (member x '(16777217d0 16777219d0 -16777217d0 16777221d0)))
                       (ref::values-of out)))))))))

(test f64-unary-functions-and-clamp-status
  (gpu:with-gpu-array (data (gpu:to-device #(0.25000000000000006d0 0.5000000000000001d0 1.0000000000000002d0)
                                          :element-type 'gpu:f64))
    (let* ((input (gpu:make-strided-view data '(3))) (values (gpu:from-device data)))
      (dolist (spec (list (list #'ew:negate #'-) (list #'ew:abs #'abs) (list #'ew:sqrt #'sqrt)
                         (list #'ew:reciprocal (lambda (x) (/ 1d0 x)))
                         (list #'ew:exp #'exp) (list #'ew:log #'log) (list #'ew:sin #'sin)
                         (list #'ew:cos #'cos) (list #'ew:tanh #'tanh)
                         (list #'ew:sigmoid (lambda (x) (/ 1d0 (+ 1d0 (exp (- x))))))
                         (list #'ew:silu (lambda (x) (/ x (+ 1d0 (exp (- x))))))
                         (list #'ew:gelu (lambda (x) (* 0.5d0 x (+ 1d0 (tanh (* (sqrt (/ 2d0 pi))
                                                                                 (+ x (* 0.044715d0 x x x))))))))))
        (with-result (out (funcall (first spec) input))
          (is (close-values (map 'vector (second spec) values) (ref::values-of out)))))
      (with-result (out (ew:clamp input 0.5000000000000001d0 1d0))
        (is (equalp #(0.5000000000000001d0 0.5000000000000001d0 1d0) (ref::values-of out))))
      (signals gpu:gpu-error (ew:clamp input input 0d0))
      (with-result (out (ew:add input 1d0)) (is (= 3 (length (ref::values-of out))))))))

(test f64-strides-windows-broadcast-destinations-and-aliases
  (gpu:with-gpu-array (data (gpu:to-device #(99d0 1d0 2d0 3d0 4d0 5d0 6d0 99d0) :element-type 'gpu:f64))
    (let* ((window (gpu:make-gpu-array-view data 7 :offset 1))
           (nested (gpu:make-gpu-array-view window 6))
           (input (gpu:make-strided-view nested '(2 3) :strides '(3 -1) :offset 2))
           (out (gpu:make-strided-view nested '(2 3) :strides '(1 2))))
      (is (eq out (ew:add! out input 16777217d0)))
      (is (equalp #(16777220d0 16777219d0 16777218d0 16777223d0 16777222d0 16777221d0)
                  (ref::values-of out)))
      (is (= 99d0 (aref (gpu:from-device data) 0)))
      (is (= 99d0 (aref (gpu:from-device data) 7)))))
  (gpu:with-gpu-array (data (gpu:to-device #(1d0 2d0 3d0 10d0 20d0) :element-type 'gpu:f64))
    (with-result (out (ew:add (gpu:make-strided-view data '(1 3))
                              (gpu:make-strided-view data '(2 1) :offset 3)))
      (is (equalp #(11d0 12d0 13d0 21d0 22d0 23d0) (ref::values-of out))))
    (with-result (out (ew:negate (gpu:make-strided-view data '(3) :strides '(0))))
      (is (equalp #(-1d0 -1d0 -1d0) (ref::values-of out))))))

(defun float-patterns (element)
  (multiple-value-bind (frac ebits bias) (ref::float-format element)
    (let ((sign (ash 1 (+ frac ebits))) (inf (ash (1- (ash 1 ebits)) frac)))
      (coerce (append (list 0 sign 1 (1+ sign) (1- (ash 1 frac)) (ash 1 frac)
                           inf (logior sign inf) (1+ inf) (logior sign inf 1) (1- inf)
                           (ash bias frac) (1+ (ash bias frac)))
                      (loop with seed = 1234567 repeat 1500
                            collect (setf seed (ldb (byte (+ 1 frac ebits) 0)
                                                   (+ (* seed 6364136223846793005) 1442695040888963407))))) 'vector))))

(test f64-floating-conversions-bit-references
  (dolist (source '(gpu:f64 gpu:f32 gpu:f16 gpu:bf16))
    (let ((patterns (float-patterns source)))
      (gpu:with-gpu-array (data (gpu:make-gpu-array (length patterns) :element-type source))
        (ref::store-raw data patterns)
        (dolist (destination (if (eq source 'gpu:f64) '(gpu:f64 gpu:f32 gpu:f16 gpu:bf16) '(gpu:f64)))
          (dolist (mode '(:nearest-even :truncate :floor :ceiling))
            (with-result (out (ew:convert (gpu:make-strided-view data (list (length patterns))) destination :rounding mode))
              (is (equalp (map 'vector (lambda (raw) (ref::reference-float-conversion raw source destination mode)) patterns)
                          (ref::load-raw (gpu:strided-view-data out)))))))))))

(test f64-single-rounding-and-directed-boundaries
  (gpu:with-gpu-array (data (gpu:to-device (vector (+ 1d0 (expt 2d0 -24))
                                                   (+ 1d0 (expt 2d0 -24) (expt 2d0 -52))
                                                   (- (+ 1d0 (expt 2d0 -24)))
                                                   (+ 1d0 (expt 2d0 -11) (expt 2d0 -52)))
                                          :element-type 'gpu:f64))
    (let ((input (gpu:make-strided-view data '(4))))
      (dolist (mode '(:nearest-even :truncate :floor :ceiling))
        (dolist (destination '(gpu:f32 gpu:f16 gpu:bf16))
          (with-result (out (ew:convert input destination :rounding mode))
            (is (equalp (map 'vector (lambda (raw) (ref::reference-float-conversion raw 'gpu:f64 destination mode))
                                      (ref::load-raw data)) (ref::load-raw (gpu:strided-view-data out))))))))))

(test f64-integer-conversions-and-error-recovery
  (dolist (element '(gpu:i8 gpu:u8 gpu:i16 gpu:u16 gpu:i32 gpu:u32 gpu:i64 gpu:u64))
    (destructuring-bind (low high) (ref::integer-bounds element)
      (let ((values (remove-duplicates
                     (remove-if-not (lambda (x) (<= low x high))
                                    (list low (1+ low) 0 1 (1- high) high
                                          (+ (expt 2 53) 3) (- (+ (expt 2 53) 3)))))))
        (gpu:with-gpu-array (data (gpu:to-device values :element-type element))
          (with-result (out (ew:convert (gpu:make-strided-view data (list (length values))) 'gpu:f64))
            (is (equalp (map 'vector (lambda (x) (coerce x 'double-float)) values) (ref::values-of out))))))
      (gpu:with-gpu-array (data (gpu:to-device #(-1.5d0 -0.5d0 0.5d0 1.5d0 2.5d0 1d100 -1d100)
                                              :element-type 'gpu:f64))
        (dolist (mode '(:nearest-even :truncate :floor :ceiling))
          (with-result (out (ew:convert (gpu:make-strided-view data '(7)) element :rounding mode))
            (is (equalp (map 'vector (lambda (x) (max low (min high (funcall (ecase mode
                                                                                           (:nearest-even #'round) (:truncate #'truncate)
                                                                                           (:floor #'floor) (:ceiling #'ceiling)) x))))
                              #(-1.5d0 -0.5d0 0.5d0 1.5d0 2.5d0 1d100 -1d100)) (ref::values-of out))))))))
  (gpu:with-gpu-array (data (gpu:make-gpu-array 3 :element-type 'gpu:f64))
    (ref::store-raw data #(#x7ff0000000000000 #xfff0000000000000 #x7ff0000000000001))
    (let ((input (gpu:make-strided-view data '(3))))
      (signals gpu:gpu-error (ew:convert input 'gpu:i64))
      (with-result (out (ew:convert input 'gpu:f64))
        (is (equalp (ref::load-raw data) (ref::load-raw (gpu:strided-view-data out)))))
      (gpu:copy-into data #(1d0 2d0 3d0))
      (with-result (out (ew:add input 16777217d0))
        (is (equalp #(16777218d0 16777219d0 16777220d0) (ref::values-of out)))))))

(test encoded-half-conversion-alias-and-window
  (dolist (element '(gpu:f16 gpu:bf16))
    (gpu:with-gpu-array (data (gpu:to-device #(99f0 1f0 2f0 3f0 99f0) :element-type element))
      (let* ((window (gpu:make-gpu-array-view data 3 :offset 1))
             (input (gpu:make-strided-view window '(3) :strides '(-1) :offset 2))
             (output (gpu:make-strided-view window '(3))))
        (ew:convert! output input)
        (is (equalp #(99f0 3f0 2f0 1f0 99f0) (gpu:from-device data)))
        (with-result (out (ew:convert input 'gpu:f64))
          (is (equalp #(1d0 2d0 3d0) (ref::values-of out))))))))

(in-suite :cl-gpu/reductions/opencl)

(test f64-all-reductions-and-close-extrema
  (gpu:with-gpu-array (data (gpu:to-device #(16777217d0 16777219d0 16777217d0) :element-type 'gpu:f64))
    (let ((input (gpu:make-strided-view data '(3))))
      (dolist (spec (list (list #'red:sum 50331653d0) (list #'red:mean (/ 50331653d0 3d0))
                         (list #'red:prod (* 16777217d0 16777219d0 16777217d0))
                         (list #'red:minimum 16777217d0) (list #'red:maximum 16777219d0)
                         (list #'red:argmin 0) (list #'red:argmax 1)))
        (with-result (out (funcall (first spec) input))
          (is (close-values (vector (second spec)) (ref::values-of out)))))
      (with-result (out (red:argmin (gpu:make-strided-view data '(3) :strides '(-1) :offset 2)))
        (is (equalp #(0) (ref::values-of out)))))))

(test f64-normalization-weights-and-epsilon
  (gpu:with-gpu-array (data (gpu:to-device #(1.0000000000000002d0 2.0000000000000004d0 3.000000000000001d0)
                                          :element-type 'gpu:f64))
    (let* ((input (gpu:make-strided-view data '(1 3))) (values (gpu:from-device data))
           (maximum (reduce #'max values))
           (exps (map 'vector (lambda (x) (exp (- x maximum))) values))
           (total (reduce #'+ exps))
           (epsilon 0.0000010000000000000002d0)
           (scale (/ 1d0 (sqrt (+ (/ (reduce #'+ values :key (lambda (x) (* x x))) 3d0) epsilon)))))
      (with-result (out (red:softmax input))
        (is (close-values (map 'vector (lambda (x) (/ x total)) exps) (ref::values-of out))))
      (with-result (out (red:rmsnorm input :weights 1.0000000000000002d0 :epsilon epsilon))
        (is (close-values (map 'vector (lambda (x) (* x scale 1.0000000000000002d0)) values) (ref::values-of out))))
      (gpu:with-gpu-array (weights (gpu:to-device #(1.0000000000000002d0 2d0 3d0) :element-type 'gpu:f64))
        (let ((weight-view (gpu:make-strided-view weights '(3) :strides '(-1) :offset 2)))
          (with-result (out (red:rmsnorm input :weights weight-view :epsilon epsilon))
            (is (close-values (map 'vector (lambda (x w) (* x scale w)) values #(3d0 2d0 1.0000000000000002d0))
                               (ref::values-of out))))))
      (with-result (out (red:rmsnorm input))
        (let ((default-scale (/ 1d0 (sqrt (+ (/ (reduce #'+ values :key (lambda (x) (* x x))) 3d0) 1d-6)))))
          (is (close-values (map 'vector (lambda (x) (* x default-scale)) values) (ref::values-of out))))))))

(test f64-axis-layouts-aliases-and-empty-validation
  (gpu:with-gpu-array (data (gpu:to-device #(99d0 1d0 2d0 3d0 4d0 5d0 6d0 99d0) :element-type 'gpu:f64))
    (let* ((window (gpu:make-gpu-array-view data 6 :offset 1))
           (input (gpu:make-strided-view window '(2 3) :strides '(3 -1) :offset 2))
           (out (gpu:make-strided-view window '(2) :strides '(2))))
      (with-result (result (red:sum input :axis -1 :keepdims t))
        (is (equalp #(2 1) (gpu:strided-view-shape result)))
        (is (equalp #(6d0 15d0) (ref::values-of result))))
      (is (eq out (red:sum! out input :axis 1)))
      (is (equalp #(6d0 15d0) (ref::values-of out))))
    (is (= 99d0 (aref (gpu:from-device data) 0)))
    (is (= 99d0 (aref (gpu:from-device data) 7))))
  (gpu:with-gpu-array (data (gpu:make-gpu-array 0 :element-type 'gpu:f64))
    (let ((input (gpu:make-strided-view data '(0 3))))
      (with-result (out (red:sum input :axis 0)) (is (equalp #(0d0 0d0 0d0) (ref::values-of out))))
      (with-result (out (red:prod input :axis 0)) (is (equalp #(1d0 1d0 1d0) (ref::values-of out))))
      (signals gpu:gpu-error (red:mean input :axis 0))
      (signals gpu:gpu-error (red:rmsnorm input :epsilon -1d0))
      (with-result (out (red:softmax input :axis 1)) (is (zerop (length (ref::values-of out)))))))
  (gpu:with-gpu-array (data (gpu:to-device #(16777217d0) :element-type 'gpu:f64))
    (with-result (out (red:sum (gpu:make-strided-view data '(3) :strides '(0))))
      (is (equalp #(50331651d0) (ref::values-of out)))))
)

(test f64-many-elements-and-in-place-normalization
  (let ((values (make-array 1025 :element-type 'double-float :initial-element 1.0000000000000002d0)))
    (gpu:with-gpu-array (data (gpu:to-device values :element-type 'gpu:f64))
      (let ((input (gpu:make-strided-view data '(1025))))
        (with-result (out (red:sum input))
          (is (close-values (vector (* 1025d0 1.0000000000000002d0)) (ref::values-of out))))
        (red:softmax! input input)
        (is (close-values (make-array 1025 :initial-element (/ 1d0 1025d0)) (ref::values-of input)))))))

(test f64-reduction-exceptional-values
  (gpu:with-gpu-array (data (gpu:make-gpu-array 3 :element-type 'gpu:f64))
    (let ((input (gpu:make-strided-view data '(3))))
      (ref::store-raw data #(#x7ff8000000000001 #x3ff0000000000000 #x4000000000000000))
      (with-result (out (red:sum input))
        (let ((bits (aref (ref::load-raw (gpu:strided-view-data out)) 0)))
          (is (= #x7ff (ldb (byte 11 52) bits)))
          (is (not (zerop (ldb (byte 52 0) bits))))))
      (with-result (out (red:argmin input)) (is (equalp #(0) (ref::values-of out))))
      (with-result (out (red:minimum input))
        (is (not (zerop (ldb (byte 52 0) (aref (ref::load-raw (gpu:strided-view-data out)) 0))))))
      (ref::store-raw data #(#x0000000000000000 #x8000000000000000 #x0000000000000000))
      (with-result (out (red:argmax input)) (is (equalp #(0) (ref::values-of out))))
      (ref::store-raw data #(#x7ff0000000000000 #x3ff0000000000000 #x4000000000000000))
      (with-result (out (red:softmax input))
        (is (every (lambda (bits) (and (= #x7ff (ldb (byte 11 52) bits)) (plusp (ldb (byte 52 0) bits))))
                   (ref::load-raw (gpu:strided-view-data out))))))))

(in-suite :cl-gpu/elementwise/opencl)

(test f64-comparisons-selection-and-exceptional-arithmetic
  (gpu:with-gpu-array (data (gpu:make-gpu-array 4 :element-type 'gpu:f64))
    (ref::store-raw data #(#x7ff8000000000001 #x8000000000000000 #x0000000000000000 #x7ff0000000000000))
    (let ((input (gpu:make-strided-view data '(4))))
      (with-result (mask (ew:compare :ne input input))
        (is (equalp #(1 0 0 0) (ref::values-of mask)))
        (with-result (out (ew:select mask input -0d0))
          (is (equalp #(#x7ff8000000000001 #x8000000000000000 #x8000000000000000 #x8000000000000000)
                      (ref::load-raw (gpu:strided-view-data out))))))
      (with-result (out (ew:reciprocal input))
        (let ((bits (ref::load-raw (gpu:strided-view-data out))))
          (is (= #xfff0000000000000 (aref bits 1)))
          (is (= #x7ff0000000000000 (aref bits 2)))
          (is (= 0 (aref bits 3))))))))

(defun reference-f64-integer (raw low high mode)
  (let* ((negative (logbitp 63 raw)) (field (ldb (byte 11 52) raw))
         (fraction (ldb (byte 52 0) raw)))
    (if (= field #x7ff) (if negative low high)
        (let* ((magnitude (* (+ fraction (if (zerop field) 0 (ash 1 52)))
                             (expt 2 (- (max 1 field) 1023 52))))
               (value (if negative (- magnitude) magnitude)))
          (max low (min high (funcall (ecase mode (:nearest-even #'round) (:truncate #'truncate)
                                                 (:floor #'floor) (:ceiling #'ceiling)) value)))))))

(test f64-integer-boundaries-against-rational-reference
  (let ((patterns (remove-if (lambda (raw) (and (= #x7ff (ldb (byte 11 52) raw))
                                               (plusp (ldb (byte 52 0) raw))))
                             (concatenate 'vector (float-patterns 'gpu:f64)
                                          #(#x43dfffffffffffff #x43e0000000000000 #xc3e0000000000000
                                            #x43efffffffffffff #x43f0000000000000)))))
    (gpu:with-gpu-array (data (gpu:make-gpu-array (length patterns) :element-type 'gpu:f64))
      (ref::store-raw data patterns)
      (dolist (element '(gpu:i8 gpu:u8 gpu:i16 gpu:u16 gpu:i32 gpu:u32 gpu:i64 gpu:u64))
        (destructuring-bind (low high) (ref::integer-bounds element)
          (dolist (mode '(:nearest-even :truncate :floor :ceiling))
            (with-result (out (ew:convert (gpu:make-strided-view data (list (length patterns))) element :rounding mode))
              (is (equalp (map 'vector (lambda (raw) (reference-f64-integer raw low high mode)) patterns)
                          (ref::values-of out))))))))))
